@page "/crm"
@attribute [Authorize(Policy = "CrmRead")]
@using My.Shared.Constants
@using My.Shared.Dtos.Crm
@using My.Shared.Rules

<PageTitle>CRM</PageTitle>

<PageHeader Title="CRM" />

<FilterBar>
    <ChildContent>
        <MudSelect T="string" Value="stageFilter" ValueChanged="OnStageChanged" Label="Stage"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true" Style="width:14rem;">
            @foreach (var stage in stages)
            {
                <MudSelectItem T="string" Value="@stage.CrmStageId">@stage.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="search" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="false" OnBlur="ReloadAsync" Style="flex:1 1 auto; width:16rem; min-width:12rem;" />
        <MudSwitch T="bool" Value="includeArchived" Label="View Archived" Color="Color.Secondary"
                   ValueChanged="@OnIncludeArchivedChanged" />
    </ChildContent>
    <Actions>
        @if (canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Href="crm/potential/new">New potential</MudButton>
        }
    </Actions>
</FilterBar>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (items.Count == 0)
{
    <MudText Typo="Typo.body2">No potentials.</MudText>
}
else
{
    <MudTable Items="items" Hover="true" Dense="true"
              OnRowClick="@((TableRowClickEventArgs<PotentialListItemDto> args) => Open(args.Item))">
        <HeaderContent>
            <MudTh>Account</MudTh>
            <MudTh>Potential</MudTh>
            <MudTh>Contact</MudTh>
            <MudTh>Stage</MudTh>
            <MudTh>Probability</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Forecast close</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Account">@context.OrganizationName</MudTd>
            <MudTd DataLabel="Potential">@context.Name</MudTd>
            <MudTd DataLabel="Contact">@context.ContactName</MudTd>
            <MudTd DataLabel="Stage">@context.StageName</MudTd>
            <MudTd DataLabel="Probability">@(context.Probability)%</MudTd>
            <MudTd DataLabel="Amount">@(context.Amount?.ToString("C"))</MudTd>
            <MudTd DataLabel="Forecast close">@(context.ExpectedCloseDate?.ToString("yyyy-MM-dd"))</MudTd>
        </RowTemplate>
    </MudTable>
}
