@page "/tyme/reports"
@* Tyme module surface. Requires a Tyme-scoped role (even for global Admins).
   Matches the Intranet scoping model: global Admin is only for cross-cutting setup. *@
@attribute [Authorize(Policy = "Tyme:User:Scoped")]

@using My.Client.Models
@using My.Client.Models.Dashboard
@using My.Client.Components.Dashboard

<PageTitle>Reports</PageTitle>

<PageHeader Title="Reports" Description="Time spent across projects, with totals and trends." />

<div>
    <FilterBar Class="reports-filter-bar">
        @* One compact row: dates stay fixed-width, project fills leftover space, buttons hug the end. *@
        <MudDatePicker @bind-Date="dateFrom" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Class="reports-filter-date" />
        <MudDatePicker @bind-Date="dateTo" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Class="reports-filter-date" />
        <div class="reports-filter-project">
            <ProjectAutocomplete @bind-Value="selectedProject" Label="Project" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" SearchFunc="SearchProjects" />
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   Class="reports-filter-btn" OnClick="ApplyFilters">Apply</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   Class="reports-filter-btn" OnClick="ClearFilters">Clear</MudButton>
    </FilterBar>

    <PageLoader IsLoading="@isLoading">
        <div class="@($"report-tabs-shell{(activeReportTab == DetailsTabIndex ? " report-tabs-shell--actions" : "")}")">
            @* Export applies to the Details grid only — Summary is charts/stats, not a row export. *@
            @if (activeReportTab == DetailsTabIndex)
            {
                <div class="report-tabs-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadCsvAsync">
                        Download
                    </MudButton>
                </div>
            }
            <MudTabs ActivePanelIndex="activeReportTab" ActivePanelIndexChanged="OnActiveReportTabChanged"
                     Outlined="true" Rounded="true" Border="true"
                     ApplyEffectsToContainer="true" KeepPanelsAlive="true" Class="mb-2">
                <MudTabPanel Text="Summary" Icon="@Icons.Material.Outlined.BarChart">
                    <MudGrid Class="mt-4">
                        <MudItem xs="12" sm="6" md="3">
                            <MudCard>
                                <MudCardContent>
                                    <MudText Typo="Typo.body2" Color="Color.Default">Total Time</MudText>
                                    <MudText Typo="Typo.h5">@totalTimeFormatted</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudCard>
                                <MudCardContent>
                                    <MudText Typo="Typo.body2" Color="Color.Default">Total Tasks</MudText>
                                    <MudText Typo="Typo.h5">@filteredTasks.Count</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudCard>
                                <MudCardContent>
                                    <MudText Typo="Typo.body2" Color="Color.Default">Top Project</MudText>
                                    <MudText Typo="Typo.h5">@topProjectName</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudCard>
                                <MudCardContent>
                                    <MudText Typo="Typo.body2" Color="Color.Default">Avg Per Day</MudText>
                                    <MudText Typo="Typo.h5">@avgPerDayFormatted</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                    <MudGrid Class="mt-4">
                        <MudItem xs="12" md="6">
                            <MudCard Class="d-flex flex-column" Style="height:100%;">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Time by Project</MudText>
                                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                                            Grouped by @ProjectMixAxisLabel.
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <div class="d-flex flex-column align-end gap-1">
                                            <MudToggleGroup T="ChartAxis" @bind-Value="projectMixAxis" Color="Color.Primary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartAxis.Organization">Org</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.Project">Project</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.ProjectGroup">Group</MudToggleItem>
                                            </MudToggleGroup>
                                            <MudToggleGroup T="ChartValueMode" @bind-Value="projectMixValueMode" Color="Color.Secondary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartValueMode.Percent">Percent</MudToggleItem>
                                                <MudToggleItem Value="ChartValueMode.Duration">Duration</MudToggleItem>
                                            </MudToggleGroup>
                                        </div>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent Class="d-flex justify-center align-center flex-grow-1">
                                    <DoughnutChart Data="@pivotedProjectChartData" Palette="@ProjectMixPalette" ValueMode="@projectMixValueMode" />
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudCard Class="d-flex flex-column" Style="height:100%;">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Daily Hours</MudText>
                                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                                            Split by @DailyHoursAxisLabel.
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <div class="d-flex flex-column align-end gap-1">
                                            <MudToggleGroup T="ChartAxis" @bind-Value="dailyHoursAxis" Color="Color.Primary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartAxis.Organization">Org</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.Project">Project</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.ProjectGroup">Group</MudToggleItem>
                                            </MudToggleGroup>
                                            <MudToggleGroup T="ChartValueMode" @bind-Value="dailyHoursValueMode" Color="Color.Secondary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartValueMode.Percent">Percent</MudToggleItem>
                                                <MudToggleItem Value="ChartValueMode.Duration">Duration</MudToggleItem>
                                            </MudToggleGroup>
                                        </div>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (DailyLabels.Any())
                                    {
                                        <MudChart T="double" ChartType="ChartType.StackedBar" ChartSeries="@DailySeries"
                                                  ChartLabels="@DailyLabels" ChartOptions="@DailyChartOptions" Width="100%" Height="300px" />
                                    }
                                    else
                                    {
                                        <MudText>No data available</MudText>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Details" Icon="@Icons.Material.Outlined.ListAlt">
                    <MudTable Items="@taskDetailRows" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Project</MudTh>
                            <MudTh>Details</MudTh>
                            <MudTh>Duration</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@FormatReportDate(context.StartDate)</MudTd>
                            <MudTd DataLabel="Project">
                                <ProjectAffiliationDisplay ProjectName="@context.Project?.Name"
                                                           DisplayName="@context.Project?.DisplayName"
                                                           OrganizationName="@context.Project?.OrganizationName"
                                                           OrganizationColor="@context.Project?.OrganizationColor"
                                                           ProjectGroupName="@context.Project?.ProjectGroupName"
                                                           ProjectGroupColor="@context.Project?.ProjectGroupColor" />
                            </MudTd>
                            <MudTd DataLabel="Details">
                                <div class="d-flex align-center" style="gap: 8px;">
                                    @if (context.AdjustmentKind is "AliasOverlay" or "DirectOverlay")
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Adjusted</MudChip>
                                    }
                                    <span>@context.Details</span>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Duration">@($"{(int)context.Duration.TotalHours:00}:{context.Duration.Minutes:00}")</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <EmptyState Icon="@Icons.Material.Outlined.SearchOff"
                                        Title="No tasks match the selected filters"
                                        Message="Adjust the date range or project filter and try again." />
                        </NoRecordsContent>
                        <FooterContent>
                            @if (taskDetailRows.Any())
                            {
                                <MudTd colspan="3" Style="font-weight:600;">Total</MudTd>
                                <MudTd Style="font-weight:600;">@durationTotalFormatted</MudTd>
                            }
                        </FooterContent>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </MudTabPanel>
            </MudTabs>
        </div>
    </PageLoader>

</div>
