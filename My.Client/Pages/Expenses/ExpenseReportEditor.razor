@page "/expenses/{Id}"
@attribute [Authorize(Policy = "Expenses:User:Scoped")]

@using Microsoft.AspNetCore.Components.Forms
@using My.Shared.Dtos.Expenses
@using My.Shared.Rules

<div data-expense-editor>
<NavigationLock ConfirmExternalNavigation="@isDirty" OnBeforeInternalNavigation="OnBeforeInternalNav" />

<PageTitle>@pageTitle</PageTitle>

<PageHeader Title="@pageTitle">
    <ChildContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("expenses"))">
                Back to list
            </MudButton>
            @if (report != null)
            {
                <ExpenseStatusChip Status="@report.Status" Size="Size.Medium"
                                   PaymentDate="@ExpensePaymentDateRules.ShownDay(report.HasPaymentDate, report.PaymentDate, report.ReimbursedAt)" />
                @if (report.HasPaymentDate)
                {
                    <MudText Typo="Typo.body2">@ExpensePayLabelRules.DateLabel @report.PaymentDate.ToString("MM/dd/yyyy")</MudText>
                }
                @if (!string.IsNullOrEmpty(statusNote))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@statusNote</MudText>
                }
            }
        </MudStack>
    </ChildContent>
    <Actions>
        @if (report != null)
        {
            <ExpensePdfMenu ReportId="@report.ExpenseReportId"
                            FileName="@PdfFileName(report)"
                            Targets="@PdfTargets"
                            CoverStart="@report.CoverStart"
                            CoverEnd="@report.CoverEnd"
                            EmployeeName="@report.EmployeeNameSnapshot"
                            Variant="Variant.Outlined" />
        }
        @if (report != null && canEdit && ShowFormCreditEntry)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddFormCreditAsync">
                Add credit
            </MudButton>
        }
        @if (report != null && canReimburse)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                       StartIcon="@Icons.Material.Filled.Paid"
                       OnClick="ReimburseAsync" Disabled="@isReimbursing">
                @ExpensePayLabelRules.Mark
            </MudButton>
        }
        @if (report != null && canUndoReimburse)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="UndoReimburseAsync" Disabled="@isUndoingReimburse">
                @ExpensePayLabelRules.Undo
            </MudButton>
        }
        @if (report != null && canUnsubmit)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.LockOpen"
                       OnClick="UnsubmitAsync" Disabled="@isUnsubmitting">
                Unsubmit
            </MudButton>
        }
        @if (report != null && canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="@(() => SaveAsync())" Disabled="@(isSaving || isSubmitting)"
                       data-expense-save="true">
                Save
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@(isSubmitting ? null : Icons.Material.Filled.Send)"
                       OnClick="SubmitAsync" Disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Submitting</span>
                }
                else
                {
                    <span>Submit</span>
                }
            </MudButton>
        }
    </Actions>
</PageHeader>

<PageLoader IsLoading="@isLoading">
    @if (report == null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                    Title="Report not found"
                    Message="This report was deleted, or you don't have access to it." />
    }
    else
    {
        <SectionCard Title="Cover period">
            <HeaderActions>
                <div class="expense-cover-total">
                    <span>@CoverTotalLabel</span>
                    <strong>@LiveMoney.NetUsd.ToString("C")</strong>
                </div>
            </HeaderActions>
            <ChildContent>
            <div class="expense-cover-row">
                <div class="expense-cover-date">
                    <MudDatePicker Date="report.CoverStart" DateChanged="SetCoverStart"
                                   Label="Cover start" DateFormat="MM/dd/yyyy"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Disabled="@(!canEdit)" Error="@(coverPeriodError != null)" />
                </div>
                <div class="expense-cover-date">
                    <MudDatePicker Date="report.CoverEnd" DateChanged="SetCoverEnd"
                                   Label="Cover end" DateFormat="MM/dd/yyyy"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Disabled="@(!canEdit)" Error="@(coverPeriodError != null)"
                                   ErrorText="@coverPeriodError" />
                </div>
                <div class="expense-cover-charge">
                    <OrganizationPickerFields OrganizationId="@report.ChargeToOrganizationId"
                                              OrganizationName="@report.ChargeToName"
                                              OrganizationIdChanged="SetChargeToId"
                                              OrganizationNameChanged="SetChargeToName"
                                              ShowDepartment="false"
                                              PreferOpenUpward="false"
                                              InputVariant="Variant.Outlined"
                                              OrganizationLabel="Charge to"
                                              Placeholder="Type to search…"
                                              AriaLabel="Charge to"
                                              Disabled="@(!canEdit)" />
                </div>
                @if (UserEntersRates)
                {
                    @foreach (var rate in CoverRates)
                    {
                        var code = rate.Code;
                        <div class="expense-cover-rate">
                            <MudNumericField T="decimal" Value="@rate.Rate" ValueChanged="@((decimal value) => SetCoverRate(code, value))"
                                             Label="@($"{code} rate")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true" Format="0.000000"
                                             Disabled="@(!canEdit)"
                                             Error="@(rate.Rate <= 0m)"
                                             ErrorText="Enter the rate." />
                        </div>
                    }
                }
            </div>
            @if (ShowFormCredits && report.FormCredits.Count > 0)
            {
                <div class="expense-cover-credits">
                    @foreach (var credit in report.FormCredits)
                    {
                        var item = credit;
                        <div class="expense-cover-credit">
                            <span>Credit — @item.Date.ToString("MM/dd/yyyy")</span>
                            <span>@item.Description</span>
                            <span>@item.Amount.ToString("N2") @item.CurrencyCode</span>
                            @if (canEdit && ShowFormCreditEntry)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           OnClick="@(() => EditFormCreditAsync(item))">Edit</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemoveFormCreditAsync(item))">Remove</MudButton>
                            }
                        </div>
                    }
                </div>
            }
            </ChildContent>
        </SectionCard>

                <SectionCard Title="Line Detail">
            <HeaderActions>
                <span class="expense-view-label">View</span>
                <MudToggleGroup T="string" Value="@editorView" ValueChanged="SetEditorViewAsync"
                                SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small"
                                aria-label="Line view">
                    <MudToggleItem Value="@ExpenseCurrencyRules.EditorDetail">Detail</MudToggleItem>
                    <MudToggleItem Value="@ExpenseCurrencyRules.EditorForm">Form</MudToggleItem>
                </MudToggleGroup>
                <span class="expense-view-label">Currency</span>
                <MudToggleGroup T="string" Value="@currencyLayout" ValueChanged="SetCurrencyLayoutAsync"
                                SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small"
                                aria-label="Currency layout">
                    <MudToggleItem Value="@ExpenseCurrencyRules.LayoutMixed">Inline</MudToggleItem>
                    <MudToggleItem Value="@ExpenseCurrencyRules.LayoutGrouped">Grouped</MudToggleItem>
                </MudToggleGroup>
                @if (canEdit)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddLine">Add line</MudButton>
                }
            </HeaderActions>
            <ChildContent>
            @if (grouped)
            {
                <div class="expense-currency-tabs">
                    @foreach (var code in GroupTabCodes)
                    {
                        var tab = code;
                        var selected = string.Equals(ActiveTabCode(), tab, StringComparison.Ordinal);
                        <div class="expense-currency-tab @(selected ? "is-active" : null)" style="@CurrencyStyle(tab)">
                            <button type="button" class="expense-currency-tab-select"
                                    @onclick="@(() => SelectCurrencyTab(tab))">@tab</button>
                            @if (CanRemoveCurrencyTab(tab))
                            {
                                <button type="button" class="expense-currency-tab-remove"
                                        aria-label="@($"Remove {tab}")"
                                        @onclick="@(() => RemoveCurrencyTab(tab))">×</button>
                            }
                        </div>
                    }
                    @if (canEdit && CurrenciesNotTabbed.Any())
                    {
                        <MudSelect T="string" Value="addCurrencyPick" ValueChanged="AddCurrencyTab"
                                   Label="Add currency" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Class="expense-currency-add" Style="flex: 0 0 11rem; width: 11rem; max-width: 11rem; margin-left: auto;">
                            @foreach (var currency in CurrenciesNotTabbed)
                            {
                                <MudSelectItem Value="@currency.Code">@currency.Code</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
            }
            @if (canEdit)
            {
                <InputFile @key="receiptPickerKey" id="expense-receipt-input"
                           OnChange="OnReceiptChosenAsync"
                           accept=".pdf,.png,.jpg,.jpeg,.webp,.heic"
                           multiple
                           style="display:none" />
            }
            @if (report.Lines.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Notes"
                            Title="No lines yet"
                            Message="Add a line for each expense (software, phone, meals, mileage, …)." />
            }
            else
            {
                <div class="@(formView ? "expense-form-scroll" : "expense-lines")">
                    @if (formView)
                    {
                        <div class="expense-form-head">
                            <span>Date</span><span>Description</span><span>Miles</span><span>T. code</span>
                            <span>Transport $</span><span>Hotel $</span><span title="Breakfast">B</span><span title="Lunch">L</span><span title="Dinner">D</span>
                            <span>Meals $</span><span>Entertain. $</span><span>Telephone $</span>
                            <span>M. code</span><span>Misc $</span>
                            <span class="expense-form-file"></span>
                        </div>
                    }
                    @foreach (var line in VisibleLines)
                    {
                        @if (formView)
                        {
                            <button type="button"
                                    class="expense-form-row @(IsFormOpen(line) ? "is-open" : null)"
                                    @onclick="@(() => ToggleFormLine(line))">
                                <span>@line.Date.ToString("MM/dd/yyyy")</span>
                                <span class="expense-form-desc">@(line.IsReturned ? "Credit — " : "")@line.Description</span>
                                <span class="expense-form-num">@FormMiles(line)</span>
                                <span>@FormTransportCode(line)</span>
                                <span class="expense-form-num">@FormTransportDollars(line)</span>
                                <span class="expense-form-num">@FormDollars(line, ExpenseCategoryRules.Hotel)</span>
                                <span class="expense-form-num">@MealMark(line, ExpenseMealRules.Breakfast)</span>
                                <span class="expense-form-num">@MealMark(line, ExpenseMealRules.Lunch)</span>
                                <span class="expense-form-num">@MealMark(line, ExpenseMealRules.Dinner)</span>
                                <span class="expense-form-num">@FormDollars(line, ExpenseCategoryRules.Meals)</span>
                                <span class="expense-form-num">@FormDollars(line, ExpenseCategoryRules.Entertainment)</span>
                                <span class="expense-form-num">@FormDollars(line, ExpenseCategoryRules.Telephone)</span>
                                <span>@FormMiscCode(line)</span>
                                <span class="expense-form-num">@FormMiscDollars(line)</span>
                                <span class="expense-form-file" title="@(ShownReceipts(line).Count > 0 ? "Receipt attached" : null)">
                                    @if (ShownReceipts(line).Count > 0)
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" aria-label="Receipt attached" />
                                    }
                                </span>
                            </button>
                        }
                    }
                    @if (formView && (!grouped || VisibleLines.Any()))
                    {
                        <div class="expense-form-row expense-form-total">
                            <span></span>
                            <span>Totals</span>
                            <span class="expense-form-num">@FormTotalMiles()</span>
                            <span></span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Transportation, ExpenseCategoryRules.Mileage)</span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Hotel)</span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Meals)</span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Entertainment)</span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Telephone)</span>
                            <span></span>
                            <span class="expense-form-num">@FormTotalMoney(ExpenseCategoryRules.Miscellaneous, ExpenseCategoryRules.Software)</span>
                            <span class="expense-form-file"></span>
                        </div>
                        @if (!grouped && LiveMoney.Currencies.Count > 1)
                        {
                            @foreach (var money in LiveMoney.Currencies)
                            {
                            <div class="expense-form-row expense-form-total">
                                <span class="expense-form-span">
                                    <span>@money.CurrencyCode</span>
                                    <span>@money.SpentAmount.ToString("N2")</span>
                                    <span>@money.UsdAmount.ToString("C")</span>
                                </span>
                            </div>
                            }
                        }
                        @if (!grouped && LiveMoney.CreditUsd > 0m)
                        {
                            <div class="expense-form-row expense-form-total">
                                <span class="expense-form-span">
                                    <span>Credit</span>
                                    <span>-@LiveMoney.CreditUsd.ToString("C")</span>
                                </span>
                            </div>
                        }
                        @if (!grouped)
                        {
                            <div class="expense-form-row expense-form-total expense-form-pay">
                                <span class="expense-form-span expense-form-grand">
                                    <span>Total</span>
                                    <span>@LiveMoney.NetUsd.ToString("C")</span>
                                </span>
                            </div>
                        }
                    }
                    @foreach (var line in formView ? VisibleLines.Where(IsFormOpen) : VisibleLines)
                    {
                        var index = report.Lines.IndexOf(line);
                        var hasDetails = ExpenseCategoryRules.HasLineDetails(line.Category);
                        var personalCar = ExpenseCategoryRules.IsPersonalCar(line.Category, line.TransportationCode);
                        <div @key="line" class="expense-line @(formView ? "is-open-detail" : null)">
                            <div class="expense-line-main">
                                <div class="expense-line-date">
                                    <MudDatePicker Date="line.Date" DateChanged="d => SetLineDate(line, d)"
                                                   Label="Date" DateFormat="MM/dd/yyyy"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Disabled="@(!canEdit)"
                                                   Error="@lineDateErrors.Contains(index)"
                                                   aria-label="Date" />
                                </div>
                                <MudSelect T="string" Value="line.Category"
                                           ValueChanged="v => SetCategory(line, v)"
                                           Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Disabled="@(!canEdit)"
                                           Error="@lineCategoryErrors.Contains(index)"
                                           Class="expense-line-category"
                                           Style="flex: 1 1 12rem; width: 12rem; min-width: 10rem; max-width: 14rem;"
                                           aria-label="Category">
                                    @foreach (var cat in contextChoices)
                                    {
                                        <MudSelectItem Value="@cat.Value">@cat.Label</MudSelectItem>
                                    }
                                </MudSelect>
                                <ExpenseAmountField Amount="line.SpentAmount"
                                                    AmountChanged="v => SetSpent(line, v)"
                                                    CurrencyCode="@line.CurrencyCode"
                                                    CurrencyCodeChanged="v => SetCurrency(line, v)"
                                                    Currencies="CurrencyOptions(line.CurrencyCode)"
                                                    ShowPicker="ShowCurrencyPicker(line)"
                                                    Disabled="@(!canEdit || personalCar)"
                                                    PickerDisabled="@(!canEdit)"
                                                    Foreign="ShowCurrencyChip(line)"
                                                    CurrencyStyle="@CurrencyStyle(line.CurrencyCode)" />
                                @if (canEdit)
                                {
                                    <div class="expense-line-remove">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Outlined.RemoveCircleOutline"
                                                   aria-label="Remove line"
                                                   Disabled="@isSaving"
                                                   OnClick="@(() => RemoveLineAsync(line))">
                                            Remove
                                        </MudButton>
                                    </div>
                                }
                            </div>
                            <div class="expense-line-body">
                                <div class="expense-line-copy">
                            <CountedTextArea Value="@line.Description"
                                             ValueChanged="@(v => SetLineDescription(line, v ?? ""))"
                                             MaxLength="@ExpenseLineRules.DescriptionMaxLength"
                                             Disabled="@(!canEdit)"
                                             Error="@lineDescriptionErrors.Contains(index)"
                                             Label="Description"
                                             AriaLabel="Description" />
                            @if (hasDetails)
                            {
                                <div class="expense-line-group">
                                    <div class="expense-line-group-title">@CategoryLabel(line.Category)</div>
                                    <div class="expense-line-group-fields">
                                        @if (line.Category == ExpenseCategoryRules.Mileage)
                                        {
                                            <div class="expense-field-miles">
                                                <MudNumericField T="decimal?" Value="line.Miles"
                                                                 ValueChanged="v => SetMiles(line, v)"
                                                                 Label="Miles" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                 Min="0m" HideSpinButtons="true" Disabled="@(!canEdit)"
                                                                 aria-label="Miles" />
                                            </div>
                                        }
                                        else if (line.Category == ExpenseCategoryRules.Transportation)
                                        {
                                            <div class="expense-field-type">
                                                <MudSelect T="string" Value="line.TransportationCode"
                                                           ValueChanged="v => SetTransportationCode(line, v)"
                                                           Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                           Clearable="true" Disabled="@(!canEdit)"
                                                           aria-label="Transportation type">
                                                    @foreach (var opt in CodeOptions(transportCodes, line.TransportationCode))
                                                    {
                                                        <MudSelectItem Value="@opt.Value">@opt.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </div>
                                            @if (personalCar)
                                            {
                                                <div class="expense-field-miles">
                                                    <MudNumericField T="decimal?" Value="line.Miles"
                                                                     ValueChanged="v => SetMiles(line, v)"
                                                                     Label="Miles" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                     Min="0m" HideSpinButtons="true" Disabled="@(!canEdit)"
                                                                     aria-label="Miles" />
                                                </div>
                                            }
                                        }
                                        else if (line.Category == ExpenseCategoryRules.Miscellaneous)
                                        {
                                            <div class="expense-field-type">
                                                <MudSelect T="string" Value="line.MiscellaneousCode"
                                                           ValueChanged="v => SetMiscellaneousCode(line, v)"
                                                           Label="Code" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                           Clearable="true" Disabled="@(!canEdit)"
                                                           aria-label="Miscellaneous code">
                                                    @foreach (var opt in CodeOptions(miscCodes, line.MiscellaneousCode))
                                                    {
                                                        <MudSelectItem Value="@opt.Value">@opt.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </div>
                                        }
                                        else if (line.Category == ExpenseCategoryRules.Meals)
                                        {
                                            <div class="expense-field-meal-type">
                                                <MudSelect T="string" Value="line.MealType"
                                                           ValueChanged="v => SetMealType(line, v)"
                                                           Label="Meal type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                           Clearable="true" Disabled="@(!canEdit)"
                                                           Error="@lineMealTypeErrors.Contains(index)"
                                                           aria-label="Meal type">
                                                    <MudSelectItem Value="@ExpenseMealRules.Breakfast">Breakfast</MudSelectItem>
                                                    <MudSelectItem Value="@ExpenseMealRules.Lunch">Lunch</MudSelectItem>
                                                    <MudSelectItem Value="@ExpenseMealRules.Dinner">Dinner</MudSelectItem>
                                                </MudSelect>
                                            </div>
                                            <div class="expense-field-head">
                                                <MudNumericField T="int?" Value="line.HeadCount"
                                                                 ValueChanged="v => SetHeadCount(line, v)"
                                                                 Label="Head count" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                 Min="0" Max="99" HideSpinButtons="true" Disabled="@(!canEdit)"
                                                                 Error="@lineHeadCountErrors.Contains(index)"
                                                                 aria-label="Head count" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                                </div>
                            <div class="expense-line-files">
                                <div class="expense-line-files-head">
                                    <span>Attachments</span>
                                    @if (canEdit)
                                    {
                                        @if (attachingLine == line)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.AttachFile"
                                                       Disabled="@(isSaving || attachingLine != null)"
                                                       OnClick="@(() => BeginAttach(line))">Attach</MudButton>
                                        }
                                    }
                                </div>
                                @if (ShownReceipts(line).Count == 0)
                                {
                                    <span class="expense-no-receipt">No receipt</span>
                                }
                                else
                                {
                                    @foreach (var receipt in ShownReceipts(line))
                                    {
                                        <div class="expense-receipt-row">
                                            <span class="expense-receipt-name" title="@receipt.OriginalFileName">@receipt.OriginalFileName</span>
                                            <MudTooltip Text="Preview">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                               aria-label="Preview receipt"
                                                               OnClick="@(() => PreviewReceiptAsync(receipt))" />
                                            </MudTooltip>
                                            <MudTooltip Text="Download">
                                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                                               aria-label="Download receipt"
                                                               OnClick="@(() => DownloadReceiptAsync(receipt))" />
                                            </MudTooltip>
                                            @if (canEdit)
                                            {
                                                <MudTooltip Text="Delete">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                   aria-label="Delete receipt"
                                                                   OnClick="@(() => RemoveReceiptAsync(line, receipt))" />
                                                </MudTooltip>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            </div>
                            @if (canMarkReturn)
                            {
                                <div class="expense-line-return">
                                    @if (line.IsReturned)
                                    {
                                        @if (CreditHasBeenUsed(line))
                                        {
                                            <MudTooltip Text="Applied to a later expense.">
                                                <span>@CreditLabel(line)</span>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <span title="@line.CreditDescription">@CreditLabel(line)</span>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       OnClick="@(() => OpenLineCreditAsync(line))">Edit</MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       OnClick="@(() => UndoReturnAsync(line))">Undo</MudButton>
                                        }
                                    }
                                    else
                                    {
                                        <MudTooltip Text="Apply this paid amount as a credit against this person's unpaid expenses with the same Charge to.">
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       OnClick="@(() => OpenLineCreditAsync(line))">Credit Back</MudButton>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (grouped && !VisibleLines.Any())
                    {
                        <MudText Typo="Typo.body2">No lines in this currency yet.</MudText>
                    }
                </div>
            }
            </ChildContent>
        </SectionCard>

@if (!formView || grouped)
{
<SectionCard Title="Totals" Class="mt-4">
            <div class="expense-yellow">
                <div class="expense-yellow-cats">
                    @foreach (var row in CategoryTotals)
                    {
                        <div class="expense-yellow-cat">
                            <span>@row.Label</span>
                            <strong>@row.Amount.ToString("C")</strong>
                        </div>
                    }
                </div>
                <div class="expense-yellow-foot">
                    @if (LiveMoney.Currencies.Count > 1)
                    {
                        <div class="expense-yellow-currencies">
                            <div class="expense-yellow-currency expense-yellow-head">
                                <span>Currency</span>
                                <span>Spent</span>
                                <span>@HomeCurrencyLabel</span>
                            </div>
                            @foreach (var row in LiveMoney.Currencies)
                            {
                                <div class="expense-yellow-currency">
                                    <span>@row.CurrencyCode</span>
                                    <span>@row.SpentAmount.ToString("N2")</span>
                                    <span>@row.UsdAmount.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="expense-yellow-results">
                        @if (LiveMoney.CreditUsd > 0m)
                        {
                            <div class="expense-yellow-cat">
                                <span>Credit</span>
                                <strong>-@LiveMoney.CreditUsd.ToString("C")</strong>
                            </div>
                        }
                        <div class="expense-yellow-pay">
                            <span>@ExpensePayLabelRules.Noun</span>
                            <strong>@LiveMoney.NetUsd.ToString("C")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </SectionCard>
}
            @if (hasPersonalCarMiles || !string.IsNullOrEmpty(meta?.HomeOrganizationName))
            {
                <MudText Typo="Typo.caption" Class="mt-3" Style="color: var(--mud-palette-text-secondary);">
                    @if (hasPersonalCarMiles)
                    {
                        <text>Mileage rate @report.MileageRateSnapshot.ToString("0.###") per mile</text>
                    }
                    @if (hasPersonalCarMiles && !string.IsNullOrEmpty(meta?.HomeOrganizationName))
                    {
                        <text> · </text>
                    }
                    @if (!string.IsNullOrEmpty(meta?.HomeOrganizationName))
                    {
                        <text>Paid by @meta.HomeOrganizationName</text>
                    }
                </MudText>
            }
    }
</PageLoader>
</div>
