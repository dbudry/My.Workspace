@page "/help"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using My.Shared.Constants

<PageTitle>Help — My Workspace</PageTitle>

<PageHeader Title="Help"
            Description="Pick a topic area, then open a guide. You only see areas you can use." />

<div class="help-layout">
    <MudPaper Class="help-nav pa-2" Elevation="0" Outlined="true">
        <MudNavMenu Color="Color.Primary" Bordered="false">
            <MudNavLink OnClick="@(() => SelectScope(HelpScope.Overview))"
                        Icon="@Icons.Material.Filled.Home"
                        Class="@(selectedScope == HelpScope.Overview ? "mud-nav-link-active active" : null)">
                Overview
            </MudNavLink>

            @if (hasTyme)
            {
                <MudNavLink OnClick="@(() => SelectScope(HelpScope.Tyme))"
                            Icon="@Icons.Material.Filled.AccessTime"
                            Class="@(selectedScope == HelpScope.Tyme ? "mud-nav-link-active active" : null)">
                    Tyme
                </MudNavLink>
            }

            @if (hasIntranet)
            {
                <MudNavLink OnClick="@(() => SelectScope(HelpScope.Intranet))"
                            Icon="@Icons.Material.Filled.MenuBook"
                            Class="@(selectedScope == HelpScope.Intranet ? "mud-nav-link-active active" : null)">
                    Intranet
                </MudNavLink>
            }

            @if (hasOrganizations)
            {
                <MudNavLink OnClick="@(() => SelectScope(HelpScope.Organizations))"
                            Icon="@Icons.Material.Filled.Business"
                            Class="@(selectedScope == HelpScope.Organizations ? "mud-nav-link-active active" : null)">
                    Organizations
                </MudNavLink>
            }

            @if (hasExpenses)
            {
                <MudNavLink OnClick="@(() => SelectScope(HelpScope.Expenses))"
                            Icon="@Icons.Material.Filled.ReceiptLong"
                            Class="@(selectedScope == HelpScope.Expenses ? "mud-nav-link-active active" : null)">
                    Expenses
                </MudNavLink>
            }

            <MudNavLink OnClick="@(() => SelectScope(HelpScope.Settings))"
                        Icon="@Icons.Material.Filled.Settings"
                        Class="@(selectedScope == HelpScope.Settings ? "mud-nav-link-active active" : null)">
                Settings
            </MudNavLink>

            <MudNavLink OnClick="@(() => SelectScope(HelpScope.Security))"
                        Icon="@Icons.Material.Filled.Shield"
                        Class="@(selectedScope == HelpScope.Security ? "mud-nav-link-active active" : null)">
                Security
            </MudNavLink>

            @if (isGlobalAdmin)
            {
                <MudNavLink OnClick="@(() => SelectScope(HelpScope.Admin))"
                            Icon="@Icons.Material.Filled.AdminPanelSettings"
                            Class="@(selectedScope == HelpScope.Admin ? "mud-nav-link-active active" : null)">
                    Admin
                </MudNavLink>
            }
        </MudNavMenu>
    </MudPaper>

    <div class="help-content">
        @if (selectedScope == HelpScope.Overview)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Overview</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="What this app is" Icon="@Icons.Material.Filled.Home" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>My Workspace</strong> is Your organization's internal workspace. Sign in with your
                        <code>your allowed domain</code> Google account.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Use the menu on the left to open a help area. Areas match what you can open in the app
                        (for example Tyme, Intranet, Organizations, or Expenses).
                    </MudText>
                    <ul class="mb-0" style="padding-left: 1.2rem;">
                        <li class="mb-1"><strong>Tyme</strong> — time tracking, calendar, availability, reports, submit</li>
                        <li class="mb-1"><strong>Intranet</strong> — company pages and documents</li>
                        <li class="mb-1"><strong>Organizations</strong> — customers, departments, and contacts</li>
                        @if (hasExpenses)
                        {
                            <li class="mb-1"><strong>Expenses</strong> — reimbursable costs against the home company (not Tyme or client work)</li>
                        }
                        <li class="mb-1"><strong>Settings</strong> — General (theme, time zone) and Tyme (project colors, Google Calendar)</li>
                        <li class="mb-1"><strong>Security</strong> — how access is enforced</li>
                        @if (isGlobalAdmin)
                        {
                            <li><strong>Admin</strong> — users, app settings, logs, debug</li>
                        }
                    </ul>
                </MudExpansionPanel>
                <MudExpansionPanel Text="New versions" Icon="@Icons.Material.Filled.SystemUpdate">
                    <MudText Typo="Typo.body2">
                        After we publish an update, this tab reloads on its own the next time you come
                        back to the app (or about every 15 minutes while it stays open). The version
                        number at the bottom of the left menu matches what you are running. Click it
                        to see what changed.
                    </MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Access levels" Icon="@Icons.Material.Filled.Badge">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Access is scoped by module. A role looks like <code>Manager:Tyme</code>,
                        <code>Editor:Intranet</code>, or <code>Manager:Organizations</code>. Bare
                        <code>Admin</code> is workspace setup only (Users, App Settings, Logs, Debug) —
                        it does not by itself open Tyme, Intranet, Organizations, or Expenses menus.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        If a menu item is missing, you do not have access to that feature. Ask someone who
                        manages accounts to assign the right module role.
                    </MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Tyme)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Tyme</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="Stopwatch" Icon="@Icons.Material.Filled.Timer" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Pick a <strong>Project</strong>, describe the work in <strong>Details</strong>
                        ("What are you working on"), then click <strong>Start</strong>.
                        Stopwatch work items need Details. On Tasks (manual, week, and calendar entries)
                        Details is optional. <strong>Enter</strong> starts the timer;
                        <strong>Shift+Enter</strong> adds a new line in Details (up to 500 characters).
                        A running work item shows a green timer icon; a stopped one is blue.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Mini Pop Out</strong> opens a slim always-on-top window so the timer can run
                        while you work in other apps.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        On the Stopwatch list, switch <strong>List</strong> / <strong>Week</strong>
                        (same idea as Tasks). List is one row per timer (all sessions totaled).
                        Week shows that week by day; pick the week with the same week-of control as Tasks.
                        The small tab under a row (down / up chevron) expands start, stop,
                        and duration — open <strong>Sessions</strong> to edit those times.
                        The X removes a work item from the list only — logged time stays
                        in Tasks and Reports. Stop the timer first. Open <strong>Sessions</strong> to edit
                        name/project when unlocked, change session durations, or
                        <strong>Delete work item</strong> (and all of its sessions). The installed app
                        opens on the mini stopwatch with the same List / Week switch and row tab.
                        Mini Pop Out keeps table columns if you shrink the
                        window (scroll sideways if needed).
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Next to Project, <strong>Org</strong> / <strong>Group</strong> chooses which color
                        the bar uses (same saved choice as Tasks → All). Hover the bar for the org or group name.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Tasks" Icon="@Icons.Material.Filled.Checklist">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Tasks</strong> has three modes (toggle at the top):
                    </MudText>
                    <ul class="mb-2" style="padding-left: 1.2rem;">
                        <li class="mb-1">
                            <strong>All</strong> — stopwatch work items and manual entries in a searchable,
                            paged list (Project, then Details). A timer on the left marks stopwatch rows
                            (green while running). Use <strong>New Task</strong> to add a completed entry.
                        </li>
                        <li class="mb-1">
                            <strong>Week</strong> — all time for one week. Defaults to the current week;
                            use the arrows or the date picker (Week of) to move weeks. The footer total
                            follows App Settings for original vs adjusted time: one total when there are
                            no corrections (or only one view is enabled); both <em>Your time</em> and
                            <em>Adjusted</em> when the setting is Both and corrections exist.
                        </li>
                        <li class="mb-1">
                            <strong>Project</strong> — choose project, week, and business/full week. Existing
                            tasks for that project this week appear as rows (Details left, day durations across).
                            Stopwatch time for that project is a read-only row (timer icon); open Sessions to edit.
                            <strong>New Task</strong> adds a row; Details is optional, then enter duration
                            (H:MM) per day. Use the edit icon next to a day to open that day's full entry
                            dialog. Footer shows this project's day totals and an <em>All projects</em> row,
                            lined up under the day boxes. Changes save automatically.
                        </li>
                    </ul>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Column headers stay visible when the list is longer than the page (All, Week List,
                        Week Day, and Project). The Total row on All stays visible while you scroll.
                        On All and Week → List you can sort by Project, Details,
                        Date, or Duration. If two timed entries share the same Project, Details, and
                        day, Week → Day shows <strong>Multiple</strong> — hover for how to edit them
                        one at a time (Calendar or All). That is not an error.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        On Week → Day, day totals at the bottom include all-day hours (usually 8 hours)
                        and line up under the duration boxes. The Total bar sits under the grid so it
                        does not cover the last rows. Stopwatch time appears as read-only rows (timer
                        icon); click a day to open Sessions. Overnight sessions stay on the start date
                        (same as All, List, Reports, and Calendar) — they are not split at midnight.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Search sits under the page description with All / Week / Project on the same control.
                        On Week, List / Day attach to the right of that bar. Business week / Full week stay
                        on the far right of the row.
                        On All it searches your full history. On Week (List or Day) it filters this
                        week's entries. On Project it filters rows for the open project.
                        Your last view and the week you were on are kept if you leave Tasks and come back
                        in the same session. Left and right arrow keys move to the previous or next week
                        (or the previous or next page on tables) unless you are typing or a dialog is open.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        In All or Week, click a row to edit Details, project, start, or duration, or delete when unlocked.
                        Duration accepts 02:30, :15, or 15m. <strong>Enter</strong> finishes the field.
                        On All, Week → List, and Stopwatch, use <strong>Org</strong> / <strong>Group</strong> next to the Project
                        column header to choose which color the bar next to each project uses. Hover the color or
                        name to see the org or group name. Week → Day does not use that control.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        A <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> lock means that
                        month is submitted — the entry opens read-only. Unsubmit (from Submit, when available)
                        reopens the month for edits.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Original and adjusted time" Icon="@Icons.Material.Filled.CompareArrows">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        When submitted time has been corrected for billing, what you see on
                        <strong>Tasks</strong>, <strong>Calendar</strong>, and <strong>Reports</strong>
                        is controlled by App Settings (admins), not a per-page choice:
                    </MudText>
                    <ul class="mb-2" style="padding-left: 1.2rem;">
                        <li class="mb-1"><strong>Original</strong> — values you originally logged</li>
                        <li class="mb-1"><strong>Adjusted</strong> — corrected values when a correction exists</li>
                        <li class="mb-1"><strong>Both</strong> — original row plus an <strong>Adjusted</strong> overlay row</li>
                    </ul>
                    <MudText Typo="Typo.body2">
                        Open an Adjusted row for a side-by-side table (original on the left, adjusted on the right).
                        Overlay rows are read-only.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Calendar" Icon="@Icons.Material.Filled.CalendarMonth">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Calendar</strong> is another view of the same tracked tasks (day, week, month).
                        Click a chip for details; click empty space to create. Right-click for edit, duplicate,
                        or delete when the entry is not locked.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Each day with time shows a hours total next to the day number in month view,
                        and under the day name in week, work week, and day view. Empty days stay blank.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        This is not Google Calendar. Sync with Google is under Settings (and Google Calendar below).
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Reports" Icon="@Icons.Material.Filled.Assessment">
                    <MudText Typo="Typo.body2">
                        <strong>Reports</strong> filters your time by date and project for summaries and charts.
                        It uses the same original / adjusted / both toggle as Tasks.
                        Time by Project and Daily Hours can group by organization or project group
                        and show percent or hours, same idea as the dashboard chart.
                        When App Settings allows it (or you are a Tyme manager/admin), an Employees
                        picker lets you include other people's time — read-only, including unsubmitted months.
                        Corrections stay on Management.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Submit" Icon="@Icons.Material.Filled.Send">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Your months</strong> lists unsubmitted months you have tracked time in,
                        through next month (so you can submit early). Submitting locks every task in that month.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        You're not limited to completed months — if you've already entered time for the
                        current month or a future one (for example, vacation you set up ahead of time), an
                        <strong>Early</strong> tag lets you submit it before it ends.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        After submit, entries cannot be edited until the month is unsubmitted.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="All-day entries" Icon="@Icons.Material.Filled.DateRange">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        On the task dialog, turn on <strong>All Day</strong> for a full-day or multi-day span.
                        Pick an inclusive end date; duration is workday hours × workdays
                        (workspace default is usually 8 hours).
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Availability entries often use All Day — see Availability below.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Projects and organizations" Icon="@Icons.Material.Filled.Folder">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        A <strong>Project</strong> is what you log against. Optional <strong>slug</strong>
                        (2–10 lowercase letters/digits, unique in the workspace) routes Google Calendar events
                        with <code>[slug]</code> in the title.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Project Groups</strong> organize lists and colors.
                        Color preference is under <strong>Settings → Tyme → Project Colors</strong>.
                        Customers and departments live under the top-level <strong>Organizations</strong>
                        menu (its own role — see Organizations in this Help). A Tyme Manager or
                        Manager:Tyme role does not by itself let you manage organizations.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Active projects appear in pickers when logging time. A project is required
                        when you log time; Details left blank are stored empty. Creating and editing the project
                        catalog is under Tyme → Projects when you have that access.
                        <strong>Download</strong> on that page saves names and slugs as a reference for
                        <code>[slug]</code> tags in Google Calendar.
                        When adding or editing a project, Organization is a search box like Project:
                        type a name, scroll, or load more. Department works the same after you pick an org.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Availability" Icon="@Icons.Material.Filled.BeachAccess">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        The shared <strong>Team Availability</strong> calendar is how the team sees who is
                        out. You do not add events on that calendar yourself. You log the time in Tyme
                        against an availability category (Vacation, OOO, Sick, Unavailable, or whatever
                        your workspace uses). Tyme then puts a short, public event on Team Availability.
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Put yourself on Team Availability</MudText>
                    <ol class="mb-3 pl-4">
                        <li class="mb-1">
                            Open <strong>Tyme → Availability</strong> if you need the exact names.
                            Those are the categories you can pick. You cannot create them unless you are
                            a Tyme manager.
                        </li>
                        <li class="mb-1">
                            Open <strong>Tyme → Tasks</strong> or <strong>Tyme → Calendar</strong> and
                            add a task (same as logging work).
                        </li>
                        <li class="mb-1">
                            Set <strong>Project</strong> to the availability category (for example Vacation).
                        </li>
                        <li class="mb-1">
                            Set the dates. Turn on <strong>All Day</strong> for a full day or a date range
                            (end date is included). For a few hours, leave All Day off and enter start
                            and duration.
                        </li>
                        <li class="mb-1">
                            Save. Time-off categories (Vacation, Sick) are submitted with the month
                            like any other time. Busy-only categories (Unavailable) appear on the
                            team calendar and do not add hours or create a month to submit.
                        </li>
                    </ol>
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        After you save, the shared calendar shows something like
                        <code>[Your Name] Vacation</code> — your name plus the category's
                        <strong>team calendar name</strong>. Notes and details stay in Tyme; the team
                        calendar only shows that you are out and which category you used.
                    </MudAlert>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">If the category is missing</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Ask a Tyme manager to add it on <strong>Tyme → Availability</strong>. Until it
                        exists as a category, you cannot put that kind of time on the shared calendar.
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Your own Google Calendar (optional)</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Team Availability is not your personal calendar. Export can still copy the Tyme
                        entry to your Google Calendar when that toggle is on under
                        <strong>Settings → Tyme → Google Calendar</strong>.
                        If a category has a <strong>slug</strong>, you can also create a Google event whose
                        title includes <code>[slug]</code> and use <strong>Import</strong> so Tyme files it
                        on that category — then the shared calendar gets the team copy as well.
                    </MudText>
                    @if (hasTymeManager)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-1">For managers — add a category</MudText>
                        <ol class="mb-3 pl-4">
                            <li class="mb-1">
                                Open <strong>Tyme → Availability</strong> and click <strong>Add Category</strong>.
                            </li>
                            <li class="mb-1">
                                <strong>Internal name</strong> is what people pick as the project in Tyme.
                            </li>
                            <li class="mb-1">
                                <strong>Team calendar name</strong> is what appears after their name on
                                Team Availability (for example Vacation). If you leave it blank, the
                                internal name is used.
                            </li>
                            <li class="mb-1">
                                Optional <strong>slug</strong> for Google import titles like <code>[vac]</code>.
                            </li>
                            <li class="mb-1">
                                <strong>Counts as Tyme hours</strong> stays on for Vacation and Sick.
                                Turn it off for Unavailable or Busy so the team calendar still shows
                                the person as out, without adding hours.
                            </li>
                        </ol>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            You can also flag a regular project <strong>Share availability with team</strong>
                            on the project form. That does not backfill old entries — only new or edited
                            time is published. The workspace calendar id is
                            <strong>Admin → App Settings → Tyme → Team Availability Calendar</strong>;
                            empty disables team publish. Staff only need view access on that calendar.
                            Writes do not use each person's Google Calendar token.
                        </MudText>
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Service account and delegate (required for writes)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Tyme updates Team Availability as a Google <strong>service account</strong>
                            that impersonates a workspace <strong>delegate user</strong> (domain-wide
                            delegation). Both must be set on the Function App, not in App Settings:
                            <code>Google__TeamAvailabilityServiceAccountJson</code> (the SA JSON key)
                            and <code>Google__TeamAvailabilityImpersonateUser</code> (a user who can
                            already <strong>Make changes to events</strong> on that calendar — production
                            uses the workspace calendar owner). In Google Workspace Admin, grant the
                            service account domain-wide delegation for
                            <code>https://www.googleapis.com/auth/calendar</code>.
                            Empty JSON disables team-calendar writes. Empty impersonate user tries to
                            write as the service account itself, which only works if the calendar is
                            shared with the SA as Make changes to events.
                        </MudText>
                    }
                    <MudText Typo="Typo.body2">
                        This is not leave balances or an approval workflow. It only records time logged
                        against those categories and mirrors a short event to the shared calendar.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Google Calendar" Icon="@Icons.Material.Filled.Event">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Calendar usually connects when you sign in with Google.
                        Manage the link under <strong>Settings → Tyme → Google Calendar</strong>.
                        Intranet files live on App Drive after a workspace Admin connects it
                        under App Settings → Drive — you do not connect your own Drive for that.
                        Only events with a <code>[slug]</code> in the title import as tasks; other events stay private.
                        A tagged event imports unless you declined the invite.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Export Tyme tasks to Google Calendar</strong> copies each Tyme task onto
                        your calendar. <strong>Import Google Calendar events into Tyme</strong> brings
                        back only events whose title includes a project <code>[slug]</code>. After you
                        connect, a dialog asks you to choose Export and Import (and a one-time backfill)
                        before sync starts. Tagged events import when you save them in Google Calendar
                        (a few seconds later if the app was idle). Edits you make in Google on a
                        Tyme-created event come back into Tyme.
                        Use <strong>Pull missed events</strong>
                        in Settings for a manual rescan — the result lists what changed and names any
                        [tag] that did not match a project. A nightly job re-scans ±7 days as a backup.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        An all-day entry spanning several weekdays (for example Tue–Thu) is one Google
                        all-day event covering those dates. Turn on <strong>Publish</strong> under Settings
                        or the event stays only in Tyme.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Under Settings you can turn on <strong>Only Availability projects</strong> so
                        import and export on your Google Calendar use only the categories a manager
                        listed on Tyme → Availability. Other projects stay in Tyme, and their
                        already-published Google events are left alone — Tyme just stops updating them —
                        unless you also opt into
                        <strong>Also remove existing Google events for projects that stop syncing</strong>.
                        The Team Availability calendar is unchanged either way.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Example: <code>[itsup] Laptop rebuild</code>. Stop Calendar sync ends import and export
                        without deleting existing Google events or Tyme tasks. Sign-in no longer
                        starts Google Calendar — connect again from Settings if you want it back.
                        To fully remove access, use Google Account → Connections.
                        If you then delete those events from Google, Tyme keeps the tasks. Deleting an
                        event from Google while still connected still removes the matching unsubmitted Tyme row.
                    </MudText>
                </MudExpansionPanel>

                @if (hasTymeManager)
                {
                    <MudExpansionPanel Text="Management" Icon="@Icons.Material.Filled.SupervisorAccount">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            <strong>Tyme → Management</strong> reviews team time: date range, employees,
                            organization, project group, project, submitted/unsubmitted, and billable filters.
                            Filters and the Summary / Task Details tab are remembered for your next visit.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Use <strong>Apply</strong> after changing dates (reloads data). Other filters update
                            the tables immediately. Columns on Task Details can be shown or hidden. Download
                            exports the active tab.
                        </MudText>
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Correcting submitted time</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Corrections apply only after that month is submitted. Workspace mode is either
                            <strong>Alias</strong> or <strong>Direct</strong> (App Settings → Tyme → Correction mode).
                        </MudText>
                        <ul class="mb-2" style="padding-left: 1.2rem;">
                            <li class="mb-1">
                                <strong>Alias</strong> — overlay on the original entry; delete the alias to revert.
                            </li>
                            <li class="mb-1">
                                <strong>Direct</strong> — updates the task and keeps an audit of previous vs new values.
                                Original values still appear on the person's Tasks list; adjusted values show on the overlay.
                            </li>
                        </ul>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Use the row menu for <strong>Update (Alias)</strong> or <strong>Update (Direct)</strong>.
                            Type in the project field to search the full catalog.
                        </MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                            Leave the project set when you only mean to change name or hours. Clearing the project
                            field saves “no project” on the correction.
                        </MudAlert>
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Team submissions</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            On <strong>Submit</strong>, <strong>Team submissions</strong> lists employee × month
                            rows in scope. <strong>Unsubmit</strong> reopens that one person's month only.
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Time-off categories live under <strong>Tyme → Availability</strong> — see Availability
                            in this Help menu.
                        </MudText>
                    </MudExpansionPanel>
                }

                @if (hasTymeManager)
                {
                    <MudExpansionPanel Text="Data" Icon="@Icons.Material.Filled.Storage">
                        <MudText Typo="Typo.body2">
                            <strong>Tyme → Data</strong> has two tabs. <strong>Extraction</strong> exports
                            selected tables to Excel. Reference tables can run without a date range;
                            time-based tables need from/to. Organization, project, and employee filters
                            are optional. <strong>Mirror</strong> shows last successful copy separately
                            from the latest run. <strong>Push</strong> starts the same app-owned GitHub
                            job as the nightly copy — it does not use the clicker's SQL login.
                        </MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Intranet)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Intranet</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="Pages and favorites" Icon="@Icons.Material.Filled.MenuBook" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Curated links appear in the sidebar. Search from the top bar (or press <kbd>/</kbd>).
                        Star a page to pin it on the dashboard, or use Add / Remove on the Favorite pages tile.
                        Unpublished drafts are only visible when you
                        have edit access.
                    </MudText>
                </MudExpansionPanel>

                @if (hasIntranetEditor)
                {
                    <MudExpansionPanel Text="Editing pages" Icon="@Icons.Material.Filled.Edit">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            <strong>Edit this page</strong> opens the editor. Save, Save &amp; view, or return
                            without saving. Uncheck <strong>Published</strong> to keep a draft out of the menu.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Toolbar: image (library/upload), file link, web link, HTML. Pasted external images
                            prefer copy-to-library (file types under App Settings → Intranet).
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Manage Pages</strong> and <strong>Documents Library</strong> are under the
                            Intranet maintenance group in the nav. Uploads go to App Drive → Intranet
                            (Images / Videos / Documents). Images on a page are shown by the app; opening a file
                            in Google Drive itself requires Shared Drive membership, which employees do not have.
                        </MudText>
                    </MudExpansionPanel>
                }

                @if (hasIntranetNavigation)
                {
                    <MudExpansionPanel Text="Navigation" Icon="@Icons.Material.Filled.AccountTree">
                        <MudText Typo="Typo.body2">
                            <strong>Intranet → Navigation</strong> is for <code>Navigation:Intranet</code>.
                            It builds the curated sidebar: internal pages
                            or external URLs, nested up to the depth set in App Settings. Prefer creating pages
                            from a parent nav item so menu placement stays consistent.
                        </MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Organizations)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Organizations</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="What Organizations is" Icon="@Icons.Material.Filled.Business" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Organizations</strong> is its own menu and role — not part of Tyme.
                        It holds customers, departments, and contacts that projects (and other modules)
                        can attach to. Sort is on the Organization column header.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        <code>User:Organizations</code> can view.
                        <code>Editor:Organizations</code> can create and edit organizations and departments.
                        <code>Manager:Organizations</code> can archive, unarchive, set active/inactive, and
                        delete (when enabled) — and includes Editor. <code>UserAccess:Organizations</code> assigns Organizations roles on Users.
                        Workspace <code>Admin</code> does not open this menu. A Tyme Manager does not
                        get it unless they also have an Organizations role.
                    </MudText>
                </MudExpansionPanel>
                @if (hasOrganizationsEditor)
                {
                    <MudExpansionPanel Text="Editing" Icon="@Icons.Material.Filled.Edit">
                        <MudText Typo="Typo.body2">
                            Create or edit an organization from the Organizations page. Archiving an
                            organization also archives its departments and projects. Unarchiving restores
                            the organization and its departments; if you also have Manager:Tyme (or
                            Manager:Tyme), you are asked whether to unarchive its projects too. Deactivating
                            an organization marks its departments inactive; you are asked whether to mark
                            its projects inactive too.
                        </MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Expenses)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Expenses</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="What Expenses is" Icon="@Icons.Material.Filled.ReceiptLong" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Expenses</strong> is reimbursable spend against the home company — the company —
                        not Tyme time and not client or project work. It has its own role
                        (<code>User:Expenses</code> / <code>Manager:Expenses</code> /
                        <code>UserAccess:Expenses</code> to assign those on Users).
                        Workspace <code>Admin</code> does not open this menu.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Open <strong>Expenses</strong>, pick a month, and click <strong>New Report</strong>.
                        On the report, <kbd>Ctrl</kbd>+<kbd>N</kbd> adds a line. Add a line per expense.
                        Personal-car mileage lives under <strong>Transportation</strong> (type Personal car, then miles).
                        Meals can be marked Breakfast / Lunch / Dinner. Attach a PDF or image on the line —
                        receipts are stored under App Drive → Expenses after a workspace Admin
                        connects that Drive in App Settings. If a line's date is after the report's
                        <strong>Cover end</strong>, attaching its receipt shows a warning so you can double-check it.
                        <kbd>Ctrl</kbd>+<kbd>S</kbd> saves. Click <strong>Submit</strong> when the month is
                        ready — that locks the report, builds the statement PDF (form + receipts), and
                        files it under App Drive → Expenses → <strong>Filed</strong> → month.
                        That filed PDF is the copy Open PDF uses after submit. A manager
                        <strong>Unsubmit</strong> removes it so the next submit files a fresh one.
                        Deleting the person later can clear their receipt folder; the filed PDF stays.
                        After the company pays you, the report shows as <strong>Reimbursed</strong>.
                        After a month ends, an unsubmitted report with lines shows on the dashboard
                        the same way unsubmitted Tyme months do.
                        Click a row to open a report. Home address and your signature live under
                        <strong>Settings → Expenses</strong>. <strong>PDF</strong> has Open / Download
                        and a legacy Form 87-43 option that fills the old Excel template.
                        iPhone HEIC receipts are converted to JPEG for the statement.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <strong>Cover period</strong> (the Start/End dates on the printed statement) defaults to
                        the full calendar month. You can shorten it, but start and end must stay in that
                        same month. Line dates must also be in that month.
                    </MudText>
                </MudExpansionPanel>
                @if (hasExpensesManager)
                {
                    <MudExpansionPanel Text="Collect, export, and QuickBooks" Icon="@Icons.Material.Filled.Groups">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Employees click <strong>Submit</strong> on a draft to lock it. Managers open
                            <strong>Expenses</strong> and switch to <strong>Team</strong> to collect
                            everyone's reports, open a report to review lines and download receipts, and
                            <strong>Unsubmit</strong> if a correction is needed (that drops the filed PDF;
                            the employee’s next Submit files a new one).
                            After the company has paid the employee, a manager clicks <strong>Reimburse</strong>.
                            <strong>Undo reimbursed</strong> returns it to submitted.
                            The dashboard lists last month's team reports.
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Expenses → Data</strong> exports reports, line items, and receipt
                            metadata to Excel. That export is the stand-in until QuickBooks Online is
                            connected. Categories are closed so a later QuickBooks account map can
                            attach without changing employee entry.
                        </MudText>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Expense settings" Icon="@Icons.Material.Filled.Tune">
                        <MudText Typo="Typo.body2">
                            <strong>Expenses → Settings</strong> is for <code>Manager:Expenses</code>.
                            Set the personal-car mileage rate — it saves when
                            you finish typing or leave the field. New reports copy
                            the rate at create time. The same page links to Team collection and Data export.
                            Home company (which Organizations row is the home company)
                            is a workspace Admin setting under App Settings → Organizations.
                            Receipts still need a workspace Admin to connect App Drive under
                            App Settings → Drive.
                        </MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Settings)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Settings</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="Appearance and display" Icon="@Icons.Material.Filled.Palette" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Settings → Appearance</strong>: Light, Dark, or System.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        <strong>Settings → Display Preferences</strong>: 12- or 24-hour clock and time zone
                        (day boundaries for tracking and reports). Preferences save as soon as you change them.
                    </MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Session expired" Icon="@Icons.Material.Filled.Warning">
                    <MudText Typo="Typo.body2">
                        If Google sign-in cannot refresh, a yellow banner asks you to sign in again.
                        A running stopwatch keeps local state — sign in and continue. Server saves fail
                        until you re-authenticate.
                    </MudText>
                </MudExpansionPanel>
                @if (hasTyme)
                {
                    <MudExpansionPanel Text="Google Calendar connection" Icon="@Icons.Material.Filled.Event">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Manage connect, Export / Import toggles, event colors (the dropdown shows the
                            actual color), disconnect, and
                            pull missed events under <strong>Settings → Tyme → Google Calendar</strong>.
                            After you connect, choose Export and Import in that first dialog — sync does
                            not start until you do. Preferences save as you change them.
                            See also Tyme → Google Calendar in this Help menu.
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Only Availability projects</strong> limits personal Google sync to
                            the categories on Tyme → Availability. Other projects stay in Tyme. The
                            Team Availability calendar is unchanged. See Tyme → Availability in this Help menu.
                        </MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Security)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Security</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="Identity provider (sign-in)" Icon="@Icons.Material.Filled.VerifiedUser" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        We don't run our own password system — sign-in is delegated entirely to
                        <strong>Google</strong> (OAuth 2.0 / OpenID Connect). Only accounts on the
                        <code>your allowed domain</code> Google Workspace domain are accepted; a personal Gmail
                        address is rejected before a session is ever created.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Every API call carries the Google-issued ID token. The server verifies its signature
                        and expiry against Google's public keys on each request — it does not just trust a
                        token because the browser sent one. If Google can't silently refresh the token
                        (expired session, revoked consent), you'll see the "session expired" banner and
                        writes are blocked until you sign in again.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Tyme calendar sync still uses a separate Google consent under Settings.
                        Intranet files and expense receipts use the workspace Drive connected under
                        App Settings → Drive, not each employee's Drive.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="The gated API" Icon="@Icons.Material.Filled.Lock">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Every request to the API goes through the same authorization checkpoint before it
                        reaches any feature code — identity is verified, then your account's roles are
                        attached, then the specific endpoint checks whether those roles are enough. Hiding
                        a button in the UI is a convenience, never the actual boundary; the server re-checks
                        on every call, including ones triggered by the keyboard or a replayed request.
                    </MudText>
                    <ul class="mb-2" style="padding-left: 1.2rem;">
                        <li class="mb-1">
                            <strong>Not signed in / bad token</strong> → rejected outright (no session).
                        </li>
                        <li class="mb-1">
                            <strong>Signed in, wrong role for that action</strong> → rejected with a generic
                            "not allowed" — the endpoint still runs the role check even if a menu item was
                            hidden from you.
                        </li>
                        <li class="mb-1">
                            Roles are scoped per module (<code>Editor:Tyme</code>, <code>Manager:Tyme</code>,
                            <code>Navigation:Intranet</code>, <code>Editor:Organizations</code>, and so on) —
                            access to one module never implies access to another. See the role table on the
                            Overview/Admin pages for what each level unlocks.
                        </li>
                        <li class="mb-1">
                            A global <strong>Admin</strong> can temporarily "View As" a module role to test
                            or troubleshoot it, instead of permanently holding that access. The same
                            server-side role check applies during impersonation — it's not a client-side skin.
                        </li>
                    </ul>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Repeated or bulk requests are throttled by rate limiting (tunable under
                        App Settings → General) so a runaway script or bug can't hammer the API.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Errors shown in the app are intentionally generic ("something went wrong") so they
                        don't leak internal details; the real error and stack trace go to server logs
                        (Admin → Logs) instead.
                    </MudText>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Data handling" Icon="@Icons.Material.Filled.Storage">
                    <ul class="mb-0" style="padding-left: 1.2rem;">
                        <li class="mb-1">Team time views and corrections stay inside the Tyme module scope — a Tyme role never sees Intranet data or vice versa.</li>
                        <li class="mb-1">Intranet page HTML is sanitized on save; uploads follow the file-type policy set in App Settings; embedded media is proxied rather than linked directly.</li>
                        <li class="mb-1">Deleting a user, organization, or project is gated separately from normal edit access, and some of it can be disabled entirely per workspace policy (App Settings → deletion gates).</li>
                    </ul>
                </MudExpansionPanel>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                    This page covers the practical basics. For the full technical write-up — the exact
                    request pipeline, role-shape validation, session invalidation, and diagrams — see
                    <code>docs/ARCHITECTURE.md</code> and <code>docs/diagrams/</code> in source control.
                </MudAlert>
            </MudExpansionPanels>
        }
        else if (selectedScope == HelpScope.Admin && isGlobalAdmin)
        {
            <MudText Typo="Typo.h6" Class="mb-3">Admin</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                <MudExpansionPanel Text="App Settings" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Admin → App Settings</strong> holds workspace-wide policy. Tyme-related items include:
                    </MudText>
                    <ul class="mb-2" style="padding-left: 1.2rem;">
                        <li class="mb-1">Manager time correction (on/off) and correction mode (Alias or Direct)</li>
                        <li class="mb-1">Whether Tyme users can view other employees on Reports (managers always can)</li>
                        <li class="mb-1">Employee time display (Original / Adjusted / Both) for Tasks, Calendar, and Reports</li>
                        <li class="mb-1">Workday hours, Team Availability calendar id (writes still need the Function App service account + impersonate user — see Tyme → Availability in this Help)</li>
                        <li class="mb-1">User/org/project deletion gates and data retention</li>
                        <li>Organizations tab: home company (which Organizations row is home) for the whole workspace</li>
                        <li>Drive tab: App Shared Drive connect, Intranet/Expenses folders, membership and Drive settings</li>
                        <li>Intranet tab: sidebar depth and upload types; API rate limits under General</li>
                    </ul>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Users" Icon="@Icons.Material.Filled.People">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        <strong>Admin → Users</strong>: Add User uses a role picker grouped by module.
                        Scoped admins can see every account and assign roles inside their module.
                        Roles in other modules stay as they are — they are not removed on save.
                        Set inactive/active, archive, force re-sign-in, revoke Google permissions,
                        optional permanent delete, and pull Google events are global Admin only.
                    </MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Logs" Icon="@Icons.Material.Filled.Article">
                    <MudText Typo="Typo.body2">
                        <strong>Admin → Logs</strong> queries Application Insights for troubleshooting.
                        Timestamps display in local time.
                    </MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Debug" Icon="@Icons.Material.Filled.BugReport">
                    <MudText Typo="Typo.body2">
                        <strong>Admin → Debug</strong> is global Admin only. <strong>Google Calendar</strong>
                        shows who is connected, whether import can run, and recent import activity in
                        plain language. <strong>Test import queue</strong> writes a message to storage
                        and confirms the worker ran. <strong>Pull missed events</strong> on a person
                        re-scans their Google Calendar.
                    </MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Impersonation" Icon="@Icons.Material.Filled.SwitchAccount">
                    <MudText Typo="Typo.body2">
                        Impersonate a module role to exercise Tyme, Intranet, or Organizations without
                        permanently holding that access. Exit from the banner or account menu when finished.
                    </MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </div>
</div>

<style>
    .help-layout {
        display: grid;
        grid-template-columns: minmax(180px, 220px) 1fr;
        gap: 1.25rem;
        align-items: start;
        max-width: 960px;
    }

    .help-nav {
        position: sticky;
        top: 1rem;
    }

    .help-content {
        min-width: 0;
    }

    @@media (max-width: 700px) {
        .help-layout {
            grid-template-columns: 1fr;
        }

        .help-nav {
            position: static;
        }
    }
</style>

@code {
    private enum HelpScope
    {
        Overview,
        Tyme,
        Intranet,
        Organizations,
        Expenses,
        Settings,
        Security,
        Admin
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private HelpScope selectedScope = HelpScope.Overview;
    private bool hasTyme;
    private bool hasTymeManager;
    private bool hasIntranet;
    private bool hasIntranetEditor;
    private bool hasIntranetNavigation;
    private bool hasOrganizations;
    private bool hasOrganizationsEditor;
    private bool hasExpenses;
    private bool hasExpensesManager;
    private bool isGlobalAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var auth = await AuthenticationStateTask;
        var user = auth.User;

        isGlobalAdmin = user.IsInRole(Constants.Roles.Admin);
        hasTyme = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Tyme, Constants.Roles.User);
        hasTymeManager = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Tyme, Constants.Roles.Manager);
        hasIntranet = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Intranet, Constants.Roles.User);
        hasIntranetEditor = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Intranet, Constants.Roles.Editor);
        hasIntranetNavigation = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Intranet, Constants.Roles.Navigation);
        hasOrganizations = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Organizations, Constants.Roles.User);
        hasOrganizationsEditor = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Organizations, Constants.Roles.Editor);
        hasExpenses = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Expenses, Constants.Roles.User);
        hasExpensesManager = Constants.Roles.HasScopedAccess(user, Constants.Scopes.Expenses, Constants.Roles.Manager);

        // Land on the first module the user can use when Help opens.
        if (hasTyme)
            selectedScope = HelpScope.Tyme;
        else if (hasIntranet)
            selectedScope = HelpScope.Intranet;
        else if (hasOrganizations)
            selectedScope = HelpScope.Organizations;
        else if (hasExpenses)
            selectedScope = HelpScope.Expenses;
        else
            selectedScope = HelpScope.Overview;
    }

    private void SelectScope(HelpScope scope)
    {
        selectedScope = scope;
    }
}
