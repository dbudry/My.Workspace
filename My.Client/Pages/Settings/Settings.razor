@page "/settings"
@attribute [Authorize]
@using My.Client.Theme
@using My.Shared.Constants
@using My.Shared.Rules

<PageTitle>Settings</PageTitle>

<PageHeader Title="Settings" Description="@settingsDescription" />

<PageLoader IsLoading="@isLoading">
    <div class="settings-stack">
        <MudTabs Outlined="true" Rounded="true" Border="true" ApplyEffectsToContainer="true"
                 KeepPanelsAlive="true" Class="mb-4" @bind-ActivePanelIndex="activeTab">
            <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Settings">
        <SectionCard Title="Appearance">
            <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
                Theme
            </MudText>
            <div class="d-flex gap-2 flex-wrap mb-1">
                <MudButton StartIcon="@Icons.Material.Filled.LightMode"
                           Variant="@(Theme.Mode == ThemeMode.Light ? Variant.Filled : Variant.Outlined)"
                           Color="@(Theme.Mode == ThemeMode.Light ? Color.Primary : Color.Default)"
                           OnClick="@(() => SetTheme(ThemeMode.Light))">Light</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.DarkMode"
                           Variant="@(Theme.Mode == ThemeMode.Dark ? Variant.Filled : Variant.Outlined)"
                           Color="@(Theme.Mode == ThemeMode.Dark ? Color.Primary : Color.Default)"
                           OnClick="@(() => SetTheme(ThemeMode.Dark))">Dark</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.SettingsBrightness"
                           Variant="@(Theme.Mode == ThemeMode.System ? Variant.Filled : Variant.Outlined)"
                           Color="@(Theme.Mode == ThemeMode.System ? Color.Primary : Color.Default)"
                           OnClick="@(() => SetTheme(ThemeMode.System))">System</MudButton>
            </div>
            <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                System matches your device's light/dark setting.
            </MudText>
        </SectionCard>

        <SectionCard Title="Display Preferences">
            <MudSwitch T="bool" @bind-Value="use24HourTime" @bind-Value:after="PersistNow"
                       Label="Use 24-hour time format"
                       Color="Color.Primary" Class="mb-1" />
            <MudText Typo="Typo.caption" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                Preview: @(use24HourTime ? DateTime.Now.ToString("HH:mm") : DateTime.Now.ToString("h:mm tt"))
            </MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" @bind-Value="selectedTimeZone" @bind-Value:after="PersistTimeZone"
                                     Label="Time Zone"
                                     SearchFunc="SearchTimeZones" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Dense="true" Class="mb-1" MaxItems="50" CoerceText="true"
                                     AdornmentIcon="@Icons.Material.Filled.Schedule" Adornment="Adornment.Start" />
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                        Used to determine day boundaries for time tracking and reports.
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTimePicker @bind-Time="defaultStartTime" @bind-Time:after="PersistDebounced"
                                   Label="Default start time"
                                   AmPm="@(!use24HourTime)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   Class="mb-1" />
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                        Prefill when creating a new timed task (in your time zone). Default is 8:00 AM.
                    </MudText>
                </MudItem>
            </MudGrid>
        </SectionCard>
            </MudTabPanel>
            <MudTabPanel Text="Tyme" Icon="@Icons.Material.Filled.Schedule">
        <SectionCard Title="Project Colors"
                     Description="How project rows and chart segments pick up a color across the app — affects the project list, calendar, stopwatch, tasks, reports, and the dashboard project mix.">
            <MudSelect T="ProjectColorSource" @bind-Value="projectColorSource" @bind-Value:after="PersistNow"
                       Label="Color source" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Style="max-width: 360px;">
                <MudSelectItem T="ProjectColorSource" Value="ProjectColorSource.GroupThenOrganization">
                    Project group, then organization
                </MudSelectItem>
                <MudSelectItem T="ProjectColorSource" Value="ProjectColorSource.Organization">
                    Organization only
                </MudSelectItem>
                <MudSelectItem T="ProjectColorSource" Value="ProjectColorSource.ProjectGroup">
                    Project group only
                </MudSelectItem>
                <MudSelectItem T="ProjectColorSource" Value="ProjectColorSource.None">
                    None
                </MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mt-2 mb-1" Style="color: var(--mud-palette-text-secondary);">
                @ProjectColorSourceCaption(projectColorSource)
            </MudText>
        </SectionCard>

        <SectionCard Title="Google Calendar"
                     Description="Connect once. Then choose what syncs. Live import needs a public webhook (not localhost).">

            @if (googleError != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@googleError</MudAlert>
            }

            @if (isGoogleConnected)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Connection</MudText>
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                    Connected as <strong>@googleEmail</strong>
                </MudAlert>
                @if (!isGoogleLiveSyncActive)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                        Live import from Google is not running on this machine. Export from Tyme still works.
                    </MudAlert>
                }
                <div class="d-flex flex-wrap gap-2 mb-1">
                    @if (!isGoogleLiveSyncActive)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="ConnectGoogle" Disabled="@isGoogleBusy">
                            @if (isGoogleBusy)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Resume live import
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="DisconnectGoogle" Disabled="@isGoogleBusy">
                        @if (isGoogleBusy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Stop Calendar sync
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="mb-4 d-block" Style="color: var(--mud-palette-text-secondary);">
                    Stop sync ends import and export. Reconnect is one click.
                    To fully remove access, use Google Account → Connections.
                </MudText>

                <MudDivider Class="mb-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">What syncs</MudText>
                <MudSwitch T="bool" @bind-Value="publishToGoogle" @bind-Value:after="PersistNow"
                           Color="Color.Primary" Class="mb-0">
                    Tyme → Google (export)
                </MudSwitch>
                <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                    New and edited Tyme tasks appear on your calendar. Off: stop sending; existing Google events stay.
                </MudText>

                <MudSwitch T="bool" @bind-Value="importFromGoogle" @bind-Value:after="PersistNow"
                           Color="Color.Primary" Class="mb-0">
                    Google → Tyme (import tagged events)
                </MudSwitch>
                <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                    Only events with a project <code>[slug]</code> in the title (e.g. <code>[itsup] Laptop rebuild</code>).
                    Untagged events stay private.
                </MudText>

                <MudSwitch T="bool"
                           Value="@((publishToGoogle || importFromGoogle) && availabilityOnlySync)"
                           ValueChanged="OnAvailabilityOnlyChanged"
                           Color="Color.Primary" Class="mb-0"
                           Disabled="@(!publishToGoogle && !importFromGoogle)">
                    Only OOO / PTO (Share availability)
                </MudSwitch>
                <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
                    Work projects stay in Tyme. Team Availability calendar is unchanged.
                </MudText>
                @if (availabilityOnlySync)
                {
                    <MudSwitch T="bool" @bind-Value="removeExcludedEvents" @bind-Value:after="PersistNow"
                               Color="Color.Primary" Class="mb-0">
                        Delete Google events when a project stops syncing
                    </MudSwitch>
                    <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                        Off: leave those events on Google. On: delete them the next time the task is edited.
                    </MudText>
                }

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Event colors</MudText>
                <MudGrid Spacing="3" Class="mb-2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="matchedColorId" @bind-Value:after="PersistNow"
                                   Label="With a project"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   ToStringFunc="GoogleEventColors.DisplayName"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Circle"
                                   Class="event-color-select"
                                   Style="@EventColorSelectStyle(matchedColorId)">
                            <MudSelectItem T="string" Value="@(null!)">Calendar default</MudSelectItem>
                            @foreach (var c in GoogleEventColors.All)
                            {
                                <MudSelectItem T="string" Value="@c.Id">
                                    <span class="d-flex align-center gap-2">
                                        <span class="google-event-color-swatch" style="background:@c.Hex"></span>
                                        @c.Name
                                    </span>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" @bind-Value="unmatchedColorId" @bind-Value:after="PersistNow"
                                   Label="No project (flag)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   ToStringFunc="GoogleEventColors.DisplayName"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Circle"
                                   Class="event-color-select"
                                   Style="@EventColorSelectStyle(unmatchedColorId)">
                            <MudSelectItem T="string" Value="@(null!)">Calendar default</MudSelectItem>
                            @foreach (var c in GoogleEventColors.All)
                            {
                                <MudSelectItem T="string" Value="@c.Id">
                                    <span class="d-flex align-center gap-2">
                                        <span class="google-event-color-swatch" style="background:@c.Hex"></span>
                                        @c.Name
                                    </span>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">Pull missed events</MudText>
                <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                    Live import can miss a save. Pick a range to re-scan tagged Google events. Already in Tyme are updated, not duplicated.
                </MudText>
                <div class="google-cal-pull-row">
                    <MudDatePicker @bind-Date="pullFromDate" Label="From" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="MM/dd/yyyy" />
                    <MudDatePicker @bind-Date="pullToDate" Label="To" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="MM/dd/yyyy" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync"
                               Class="google-cal-pull-btn"
                               OnClick="PullFromGoogle" Disabled="@isPullingFromGoogle">
                        @if (isPullingFromGoogle)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Pull missed events
                    </MudButton>
                </div>
                @if (pullResult != null)
                {
                    <MudAlert Severity="@(pullResult.Error != null ? Severity.Warning : Severity.Success)"
                              Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        @if (pullResult.Error != null)
                        {
                            @pullResult.Error
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @CalendarPullResultRules.Headline(pullResult)
                            </MudText>
                            <MudStack Spacing="1">
                                @foreach (var line in CalendarPullResultRules.DetailLines(pullResult))
                                {
                                    <MudText Typo="Typo.body2">@line</MudText>
                                }
                            </MudStack>
                            @if (pullResult.UnresolvedTags.Count > 0)
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">
                                    These Google titles have a [tag] that does not match any project.
                                    Fix the tag in Google, or set that slug on a project, then pull again.
                                </MudText>
                                <ul class="mt-1 mb-0">
                                    @foreach (var note in pullResult.UnresolvedTags)
                                    {
                                        <li>
                                            <MudText Typo="Typo.body2">
                                                @note.Summary
                                                @if (!string.IsNullOrEmpty(note.Tag))
                                                {
                                                    <text> — no project uses [@note.Tag]</text>
                                                }
                                            </MudText>
                                        </li>
                                    }
                                </ul>
                            }
                            @if (pullResult.Created + pullResult.Updated > 0)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           Class="mt-2 px-0" Href="tyme/tasks">
                                    Open Tasks
                                </MudButton>
                            }
                        }
                    </MudAlert>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                    Connect your Google account to export Tyme tasks and import events tagged with a project
                    <code>[slug]</code>.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Event"
                           OnClick="ConnectGoogle" Disabled="@isGoogleBusy">
                    @if (isGoogleBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Connect Google Calendar
                </MudButton>
            }
        </SectionCard>
            </MudTabPanel>
            @if (hasExpensesAccess)
            {
                <MudTabPanel Text="Expenses" Icon="@Icons.Material.Filled.ReceiptLong">
                    <SectionCard Title="Home address">
                        <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                            Printed on Form 87-43 under ADDRESS. Street on the first line, city and ZIP on the second.
                            Copied onto new expense reports.
                        </MudText>
                        <MudTextField @bind-Value="expenseHomeStreet" @bind-Value:after="PersistDebounced"
                                      Label="Street" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" MaxLength="120" />
                        <MudTextField @bind-Value="expenseHomeCityLine" @bind-Value:after="PersistDebounced"
                                      Label="City, state ZIP" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" MaxLength="120" Class="mt-2" />
                    </SectionCard>
                    <SectionCard Title="Expense signature">
                        <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                            Saved on your profile. Stamped as Employee's Signature on expense PDFs you download.
                            Reused until you replace it — it is not stored on Drive.
                        </MudText>
                        <SignatureEditor MediaUrl="@Constants.API.Expenses.MySignatureMedia"
                                         PutUrl="@Constants.API.Expenses.MySignature"
                                         DeleteUrl="@Constants.API.Expenses.MySignature"
                                         @bind-HasSignature="hasExpenseSignature" />
                    </SectionCard>
                </MudTabPanel>
            }
        </MudTabs>
    </div>
</PageLoader>

<style>
    .settings-stack {
        max-width: 960px;
    }
</style>
