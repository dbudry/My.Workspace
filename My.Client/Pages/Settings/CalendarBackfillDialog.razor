@namespace My.Client.Pages.Settings

@*
    Shown once, right after a first-time user connects Google Calendar (they've already
    gone through Google's own consent screen by this point — that part isn't ours to
    explain). This is the first and only Tyme-owned moment to explain what ongoing sync
    actually means and let the user opt out of it, since PublishToGoogleCalendar and
    ImportFromGoogleCalendar both default to true server-side (UserSettings.cs) — without
    this dialog, sync starts silently the moment the calendar connects. Previously this
    dialog only asked about the one-time historical backfill; it now also surfaces (and
    lets the user turn off) the two ongoing sync toggles that otherwise default to "on"
    with no explanation. Same choices as Settings, just asked once up front.
*@
<MudDialog>
    <DialogContent>
        <DialogFormStack>
            <MudText>
                Choose what syncs. Same options as Settings → Tyme → Google Calendar.
            </MudText>

            <MudSwitch T="bool" @bind-Value="publishToGoogle" Color="Color.Primary" Class="mb-0">
                Tyme → Google (export)
            </MudSwitch>
            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                New and edited Tyme tasks appear on your calendar. Off: stop sending; existing Google events stay.
            </MudText>

            <MudSwitch T="bool" @bind-Value="importFromGoogle" Color="Color.Primary" Class="mb-0">
                Google → Tyme (import tagged events)
            </MudSwitch>
            <MudText Typo="Typo.caption" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                Only events with a project <code>[slug]</code> in the title (e.g. <code>[itsup] Laptop rebuild</code>).
                Untagged events stay private.
            </MudText>

            <MudSwitch T="bool"
                       Value="@((publishToGoogle || importFromGoogle) && availabilityOnly)"
                       ValueChanged="v => availabilityOnly = v"
                       Color="Color.Primary" Class="mb-0"
                       Disabled="@(!publishToGoogle && !importFromGoogle)">
                Only OOO / PTO (Share availability)
            </MudSwitch>
            <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
                Work projects stay in Tyme. Team Availability calendar is unchanged.
            </MudText>

            @if (publishToGoogle)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.body2">
                    Optionally push existing Tyme tasks in a date range so Google also shows recent work:
                </MudText>
                <div class="google-cal-pull-row mt-2">
                    <MudDatePicker @bind-Date="fromDate" Label="From" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="MM/dd/yyyy" />
                    <MudDatePicker @bind-Date="toDate" Label="To" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="MM/dd/yyyy" />
                </div>
                <MudText Typo="Typo.caption" Class="mt-1" Style="color: var(--mud-palette-text-secondary);">
                    Tasks already on a calendar are skipped.
                </MudText>
            }
        </DialogFormStack>
    </DialogContent>
    <DialogActions>
        @if (publishToGoogle)
        {
            <MudButton OnClick="SkipBackfill">Skip backfill</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">
            @(publishToGoogle ? "Sync to calendar" : "Save preferences")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>Default lookback in days from the workspace AppSetting.</summary>
    [Parameter] public int DefaultDays { get; set; } = 30;

    // Both default true — matches UserSettings.PublishToGoogleCalendar /
    // ImportFromGoogleCalendar's server-side defaults, so the switches accurately
    // reflect what's about to happen if the user doesn't change anything.
    private bool publishToGoogle = true;
    private bool importFromGoogle = true;
    private bool availabilityOnly;

    private DateTime? fromDate;
    private DateTime? toDate;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        fromDate = today.AddDays(-DefaultDays);
        toDate = today;
    }

    private void Confirm()
    {
        var range = publishToGoogle && fromDate is not null && toDate is not null
            ? new BackfillRange(fromDate.Value, toDate.Value)
            : null;
        Dialog.Close(DialogResult.Ok(new BackfillChoice(publishToGoogle, importFromGoogle, AvailabilityOnlyToSave, range)));
    }

    private bool AvailabilityOnlyToSave =>
        (publishToGoogle || importFromGoogle) && availabilityOnly;

    private void SkipBackfill() =>
        Dialog.Close(DialogResult.Ok(new BackfillChoice(publishToGoogle, importFromGoogle, AvailabilityOnlyToSave, null)));

    public record BackfillRange(DateTime From, DateTime To);

    /// <summary>
    /// The user's full sync decision: whether to keep export/import on (both default true)
    /// and, if export stayed on, the optional historical date range to push. Range is null
    /// when publishToGoogle is off (nothing to backfill) or the user chose "Skip backfill".
    /// </summary>
    public record BackfillChoice(bool PublishToGoogle, bool ImportFromGoogle, bool AvailabilityOnly, BackfillRange? Range);
}
