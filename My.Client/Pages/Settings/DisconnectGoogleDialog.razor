@namespace My.Client.Pages.Settings

<MudDialog>
    <DialogContent>
        <DialogFormStack>
            <MudText>
                This stops import and export with your primary Google calendar.
                Events already on Google stay there. Tyme tasks stay in Tyme.
            </MudText>
            <MudText>
                Reconnect is one click. This does not forget your Google credential.
            </MudText>
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                To fully remove access, visit
                <MudLink Href="https://myaccount.google.com/connections" Target="_blank" Underline="Underline.Always">Google Account → Connections</MudLink>.
            </MudText>
        </DialogFormStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">Stop sync</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
    private void Cancel() => Dialog.Cancel();
}
