@using MudBlazor.Utilities

<div class="color-picker-field @(Swatch ? "color-picker-swatch" : null) @Class"
     style="@(Swatch ? $"--color-swatch: {SwatchHex};" : null)"
     title="@(Swatch ? SwatchHex : null)">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">@Label</MudText>
    }
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
            @HelperText
        </MudText>
    }

    @* Swatch paints the closed control with the color. The hex stays inside the picker. *@
    <MudColorPicker Value="pickerColor"
                    ValueChanged="OnColorChanged"
                    ShowAlpha="false"
                    ShowModeSwitch="false"
                    ColorPickerMode="ColorPickerMode.HEX"
                    PickerVariant="@(Swatch ? PickerVariant.Inline : Variant)"
                    ShowToolbar="@Swatch"
                    Editable="@(!Swatch)"
                    Adornment="@(Swatch ? Adornment.None : Adornment.End)"
                    Margin="@(Swatch ? Margin.Dense : Margin.None)"
                    Variant="@(Swatch ? global::MudBlazor.Variant.Outlined : global::MudBlazor.Variant.Text)"
                    Disabled="@Disabled"
                    aria-label="@(Swatch ? "Color" : null)" />
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Static keeps the palette open, which is what the organization and project dialogs use.
    /// Inline shows the hex and opens that same palette. Ignored when <see cref="Swatch"/> is set.
    /// </summary>
    [Parameter] public PickerVariant Variant { get; set; } = PickerVariant.Static;

    /// <summary>
    /// Closed control is the color itself. Clicking it opens the same picker, where the hex can still be typed.
    /// </summary>
    [Parameter] public bool Swatch { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter]
    public string? ColorHex { get; set; }

    [Parameter]
    public EventCallback<string?> ColorHexChanged { get; set; }

    private MudColor pickerColor = new("#1976d2");

    private string SwatchHex => pickerColor.ToString(MudColorOutputFormats.Hex);

    protected override void OnParametersSet()
    {
        var next = string.IsNullOrWhiteSpace(ColorHex) ? "#1976d2" : ColorHex;
        if (!string.Equals(pickerColor.ToString(MudColorOutputFormats.Hex), next, StringComparison.OrdinalIgnoreCase))
            pickerColor = new MudColor(next);
    }

    private async Task OnColorChanged(MudColor value)
    {
        pickerColor = value;
        await ColorHexChanged.InvokeAsync(value.ToString(MudColorOutputFormats.Hex));
    }
}