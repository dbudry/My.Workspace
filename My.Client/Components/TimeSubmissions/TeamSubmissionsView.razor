@namespace My.Client.Components.TimeSubmissions
@using My.Client.Components.Common
@using My.Client.Services
@using My.Shared.Constants
@using My.Shared.Dtos.TimeSubmission
@using My.Shared.Rules
@using System.Net
@using System.Net.Http.Json

@inject IHttpClientFactory ClientFactory
@inject ISnackbar Snackbar
@inject SubmissionActionsService Actions
@inject AppSettingsCache AppSettingsCache


@*
    Reusable manager view of (user × month) submission rows.

    Two consumers:
      - /tyme/submit page: ShowFilters=true, ShowActions=true, DefaultStatusFilter="all", no MaxRows.
      - Dashboard widget:  ShowFilters=false, ShowActions=false, DefaultStatusFilter="unsubmitted", MaxRows=10.

    The component self-fetches via GET /api/timesubmissions/team and re-fetches
    whenever filters change. Any Unsubmit action refreshes the underlying list.
*@

<div>
    @if (ShowFilters)
    {
        <div class="d-flex flex-wrap align-center gap-3 mb-3">
            <div style="flex:0 0 200px; width:200px;">
                <MultiSelectCheckList Options="@SubmissionGridRules.StatusOptions" SelectedKeys="@statusFilter"
                                      SelectedKeysChanged="OnStatusChanged" Label="Status"
                                      AllLabel="All statuses" ShowSearch="false" />
            </div>
            <div style="flex:0 0 220px; width:220px;">
                <MultiSelectCheckList Options="@employeeOptions" SelectedKeys="@selectedUserIds"
                                      SelectedKeysChanged="OnEmployeesChanged" Label="Employee"
                                      AllLabel="All employees" />
            </div>
            <div style="flex:0 0 140px; width:140px;">
                <MonthPicker Value="@fromDate" ValueChanged="OnFromChanged" Label="From month" />
            </div>
            <div style="flex:0 0 140px; width:140px;">
                <MonthPicker Value="@toDate" ValueChanged="OnToChanged" Label="To month" />
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ReloadAsync"
                           title="Refresh" aria-label="Refresh" />
        </div>
    }

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-2" />
    }
    else if (visibleRows.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
            @EmptyMessage
        </MudText>
    }
    else
    {
        <MudTable Items="@visibleRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Employee</MudTh>
                <MudTh Style="width:160px;">Month</MudTh>
                <MudTh Style="width:140px;">Status</MudTh>
                @if (ShowActions)
                {
                    <MudTh Style="width:280px; text-align:right;">Actions</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Employee">@context.UserName</MudTd>
                <MudTd DataLabel="Month">@(new DateTime(context.Year, context.Month, 1).ToString("MMMM yyyy"))</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsSubmitted)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                            Submitted
                        </MudChip>
                    }
                    else if (context.NoTime)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.HorizontalRule">
                            No time
                        </MudChip>
                    }
                    else if (context.Open)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.HourglassEmpty">
                            In progress
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule">
                            Not submitted
                        </MudChip>
                    }
                </MudTd>
                @if (ShowActions)
                {
                    <MudTd DataLabel="Actions" Style="text-align:right;">
                        @if (!context.IsSubmitted && !context.NoTime && !context.Open && reminderEnabled)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Email"
                                       OnClick="@(() => SendReminderAsync(context))"
                                       Disabled="@(busyKey == BusyKeyFor(context))"
                                       Class="mr-1">
                                Remind
                            </MudButton>
                        }
                        @if (!context.IsSubmitted && !context.NoTime && !context.Open && allowManagerSubmitOnBehalf)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       OnClick="@(() => SubmitOnBehalfAsync(context))"
                                       Disabled="@(busyKey == BusyKeyFor(context))"
                                       Class="mr-1">
                                Submit
                            </MudButton>
                        }
                        else if (context.IsSubmitted && !string.IsNullOrEmpty(context.TimeSubmissionId))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.LockOpen"
                                       OnClick="@(() => UnsubmitAsync(context))"
                                       Disabled="@(busyKey == BusyKeyFor(context))">
                                Unsubmit
                            </MudButton>
                        }
                    </MudTd>
                }
            </RowTemplate>

        </MudTable>

        @if (MaxRows.HasValue && allRows.Count > MaxRows.Value)
        {
            <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                Showing @visibleRows.Count of @allRows.Count. Open Team for the rest.
            </MudText>
        }
    }
</div>

@code {
    /// <summary>When true, render the filter bar above the table. Hide on dashboard.</summary>
    [Parameter] public bool ShowFilters { get; set; } = true;

    /// <summary>When false, the table is awareness-only (no Submit/Unsubmit). Dashboard uses this.</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    /// <summary>Initial status filter: "all" or a comma list of submitted, unsubmitted, open, notime.</summary>
    [Parameter] public string DefaultStatusFilter { get; set; } = "all";


    /// <summary>Cap visible rows. Used by the dashboard widget to keep the card compact.</summary>
    [Parameter] public int? MaxRows { get; set; }

    /// <summary>Empty-state copy. Override per consumer for context.</summary>
    [Parameter] public string EmptyMessage { get; set; } = "Nothing to show.";

    private HttpClient client = null!;
    private bool isLoading = true;
    private string? busyKey;
    private bool allowManagerSubmitOnBehalf;
    private bool reminderEnabled;


    /// <summary>Picked status keys (submitted, unsubmitted, open, notime). null = all, empty = none.</summary>
    private IReadOnlyCollection<string>? statusFilter;
    private async Task OnStatusChanged(IReadOnlyCollection<string>? keys)
    {
        statusFilter = keys;
        await ReloadAsync();
    }
    /// <summary>null = all employees, empty = none, otherwise the picked ids.</summary>
    private IReadOnlyCollection<string>? selectedUserIds;
    private async Task OnEmployeesChanged(IReadOnlyCollection<string>? keys)
    {
        selectedUserIds = keys;
        await ReloadAsync();
    }
    // Month range (first day of each month). Starts at last, this and next month, like the Grid.
    // Left null when the filters are hidden (dashboard widget), which means no date limit.
    private DateTime? fromDate;
    private DateTime? toDate;

    private async Task OnFromChanged(DateTime? value)
    {
        if (value == null) return;
        fromDate = new DateTime(value.Value.Year, value.Value.Month, 1);
        await ReloadAsync();
    }

    private async Task OnToChanged(DateTime? value)
    {
        if (value == null) return;
        toDate = new DateTime(value.Value.Year, value.Value.Month, 1);
        await ReloadAsync();
    }

    private List<TeamSubmissionRowDto> allRows = new();
    // Every employee seen on any load so far. Never shrinks when a filter narrows the rows,
    // so a picked employee keeps showing their name instead of falling back to their id.
    private readonly Dictionary<string, string> knownUsers = new();
    private IReadOnlyList<(string Key, string Text)> employeeOptions = [];

    private List<TeamSubmissionRowDto> visibleRows =>
        MaxRows.HasValue ? allRows.Take(MaxRows.Value).ToList() : allRows;

    protected override async Task OnInitializedAsync()
    {
        client = ClientFactory.CreateClient(Constants.API.ClientName);
        // "all" (or unset) is a null selection; anything else is a comma list of status keys.
        statusFilter = SubmissionGridRules.ParseStatusFilter(DefaultStatusFilter).Count
                       == SubmissionGridRules.StatusOptions.Count
            ? null
            : SubmissionGridRules.ParseStatusFilter(DefaultStatusFilter).ToList();
        if (ShowFilters)
        {
            var (from, to) = SubmissionGridRules.DefaultRange(DateTime.UtcNow);
            fromDate = new DateTime(from.Year, from.Month, 1);
            toDate = new DateTime(to.Year, to.Month, 1);
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allowManagerSubmitOnBehalf = false;
            reminderEnabled = false;
            if (ShowActions)
            {
                try
                {
                    var settings = await AppSettingsCache.GetAsync();
                    var row = settings.FirstOrDefault(s =>
                        string.Equals(s.Key, Constants.SettingKeys.TymeAllowManagerSubmitOnBehalf, StringComparison.Ordinal));
                    allowManagerSubmitOnBehalf = ManagerSubmitOnBehalfRules.IsEnabled(row?.Value);
                    var reminder = settings.FirstOrDefault(s =>
                        string.Equals(s.Key, Constants.SettingKeys.TymeUnsubmittedReminderEnabled, StringComparison.Ordinal));
                    reminderEnabled = UnsubmittedReminderRules.IsEnabled(reminder?.Value);
                }
                catch
                {
                    allowManagerSubmitOnBehalf = false;
                    reminderEnabled = false;
                }
            }

            if (selectedUserIds is { Count: 0 } || statusFilter is { Count: 0 })
            {
                // Every employee or status box is cleared: nothing to show, no request needed.
                allRows = new();
                return;
            }

            var statusText = statusFilter == null ? "all" : string.Join(",", statusFilter);
            var qs = new List<string> { $"status={Uri.EscapeDataString(statusText)}" };
            if (selectedUserIds != null) qs.Add($"userId={Uri.EscapeDataString(string.Join(",", selectedUserIds))}");
            if (fromDate.HasValue) qs.Add($"from={SubmissionGridRules.FormatMonth(fromDate.Value.Year, fromDate.Value.Month)}");
            if (toDate.HasValue) qs.Add($"to={SubmissionGridRules.FormatMonth(toDate.Value.Year, toDate.Value.Month)}");
            var url = $"{Constants.API.TimeSubmission.GetTeam}?{string.Join("&", qs)}";

            var rows = await client.GetFromJsonAsync<List<TeamSubmissionRowDto>>(url);
            allRows = rows ?? new();
            foreach (var r in allRows)
                knownUsers[r.UserId] = r.UserName;
            employeeOptions = knownUsers
                .Select(kv => (Key: kv.Key, Text: kv.Value))
                .OrderBy(x => x.Text, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            // Client role claims may lag behind the DB briefly after a self role change;
            // UnauthorizedDelegatingHandler already surfaces a permission snackbar.
            allRows = new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't load team submissions: {ex.Message}", Severity.Error);
            allRows = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SendReminderAsync(TeamSubmissionRowDto row)
    {
        busyKey = BusyKeyFor(row);
        try
        {
            await Actions.SendReminderAsync(row.UserId, row.UserName, row.Year, row.Month);
        }
        finally
        {
            busyKey = null;
        }
    }

    private async Task SubmitOnBehalfAsync(TeamSubmissionRowDto row)
    {
        if (row.IsSubmitted) return;

        busyKey = BusyKeyFor(row);
        try
        {
            if (await Actions.SubmitOnBehalfAsync(row.UserId, row.UserName, row.Year, row.Month))
                await ReloadAsync();
        }
        finally
        {
            busyKey = null;
        }
    }

    private async Task UnsubmitAsync(TeamSubmissionRowDto row)
    {
        if (string.IsNullOrEmpty(row.TimeSubmissionId)) return;

        busyKey = BusyKeyFor(row);
        try
        {
            if (await Actions.UnsubmitAsync(row.TimeSubmissionId, row.UserName, row.Year, row.Month))
                await ReloadAsync();
        }
        finally
        {
            busyKey = null;
        }
    }

    private static string BusyKeyFor(TeamSubmissionRowDto row) => $"{row.UserId}-{row.Year}-{row.Month}";
}
