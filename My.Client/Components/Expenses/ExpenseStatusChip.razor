@using My.Shared.Rules

@if (ExpenseStatusRules.IsReimbursed(Status))
{
    @if (PaymentDate is DateTime paidOn)
    {
        <MudTooltip Text="@paidOn.ToString("MM/dd/yyyy")">
            <MudChip T="string" Color="Color.Tertiary" Size="@Size" Icon="@Icons.Material.Filled.Paid">@PaidWord</MudChip>
        </MudTooltip>
    }
    else
    {
        <MudChip T="string" Color="Color.Tertiary" Size="@Size" Icon="@Icons.Material.Filled.Paid">@PaidWord</MudChip>
    }
}
else if (ExpenseStatusRules.IsSubmitted(Status))
{
    <MudChip T="string" Color="Color.Success" Size="@Size" Icon="@Icons.Material.Filled.CheckCircle">Submitted</MudChip>
}
else
{
    <MudChip T="string" Color="Color.Info" Size="@Size" Icon="@Icons.Material.Filled.Edit">Draft</MudChip>
}

@code {
    [Parameter] public string? Status { get; set; }
    [Parameter] public DateTime? PaymentDate { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;

    private string PaidWord => ExpensePayLabelRules.StatusWord(Status);
}
