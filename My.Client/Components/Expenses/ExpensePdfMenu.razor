@using My.Client.Extensions
@using My.Shared.Constants
@using My.Shared.Dtos.Expenses
@using My.Shared.Rules
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (busy)
{
    <MudTooltip Text="@busyLabel">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
    </MudTooltip>
}
else if (IconOnly)
{
    <MudMenu Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Dense="true"
             Color="@Color" Disabled="@Disabled"
             AriaLabel="PDF"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        @MenuItems
    </MudMenu>
}
else
{
    <MudMenu Dense="true" Disabled="@Disabled"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        <ActivatorContent>
            <MudButton Variant="@Variant" Color="@Color"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       Disabled="@Disabled"
                       OnClick="@context.ToggleAsync">
                PDF
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            @MenuItems
        </ChildContent>
    </MudMenu>
}

@code {
    [Parameter] public string ReportId { get; set; } = "";
    [Parameter] public string FileName { get; set; } = "Expenses.pdf";
    [Parameter] public IReadOnlyList<ExpensePdfTarget>? Targets { get; set; }
    [Parameter] public DateTime? CoverStart { get; set; }
    [Parameter] public DateTime? CoverEnd { get; set; }
    [Parameter] public string? EmployeeName { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Color Color { get; set; } = Color.Default;

    private bool busy;
    private string busyLabel = "Preparing PDF…";

    private IReadOnlyList<ExpensePdfTarget> MenuTargets =>
        Targets is { Count: > 0 } ? Targets : [new ExpensePdfTarget()];

    private bool SplitMenu => MenuTargets.Count > 1;

    private RenderFragment MenuItems => __builder =>
    {
        foreach (var target in MenuTargets)
        {
            var current = target;
            var suffix = SplitMenu ? " — " + DisplayName(current) : "";
            <MudMenuItem Icon="@Icons.Material.Filled.Visibility" Disabled="@busy"
                         OnClick="@(() => PreviewAsync(current))">
                @($"Preview{suffix}")
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" Disabled="@busy"
                         OnClick="@(() => RunAsync(true, current))">
                @($"Open PDF{suffix}")
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Download" Disabled="@busy"
                         OnClick="@(() => RunAsync(false, current))">
                @($"Download{suffix}")
            </MudMenuItem>
        }
    };

    private static string DisplayName(ExpensePdfTarget target) =>
        string.IsNullOrWhiteSpace(target.Name) ? "No Charge to" : target.Name;

    private string? ChargeQuery(ExpensePdfTarget target)
    {
        if (!SplitMenu)
            return null;
        return string.IsNullOrWhiteSpace(target.ChargeToOrganizationId)
            ? ExpenseChargeToRules.UnassignedQuery
            : target.ChargeToOrganizationId;
    }

    private string DownloadName(ExpensePdfTarget target)
    {
        if (!SplitMenu || CoverStart is null || CoverEnd is null)
            return FileName;
        return ExpenseDriveNamingRules.StatementFileName(
            CoverStart.Value, CoverEnd.Value, EmployeeName, DisplayName(target));
    }

    private async Task PreviewAsync(ExpensePdfTarget target)
    {
        if (string.IsNullOrWhiteSpace(ReportId) || busy)
            return;

        busy = true;
        busyLabel = "Preparing PDF…";
        Snackbar.Add(busyLabel, Severity.Info);
        await InvokeAsync(StateHasChanged);
        try
        {
            var client = ClientFactory.CreateClient(Constants.API.ClientName);
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            using var response = await client.GetAsync(
                Constants.API.Expenses.Pdf(ReportId, ChargeQuery(target)), cts.Token);
            response.EnsureSuccessStatusCode();
            var bytes = await response.Content.ReadAsByteArrayAsync(cts.Token);
            var parameters = new DialogParameters<ExpensePdfPreviewDialog>
            {
                { dialog => dialog.FileName, DownloadName(target) },
                { dialog => dialog.Base64, Convert.ToBase64String(bytes) }
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true
            };
            await DialogService.ShowAsync<ExpensePdfPreviewDialog>("Preview", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.AddApiError(ex, "Couldn't preview the PDF.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunAsync(bool open, ExpensePdfTarget target)
    {
        if (string.IsNullOrWhiteSpace(ReportId) || busy)
            return;

        busy = true;
        busyLabel = "Preparing PDF…";
        Snackbar.Add(busyLabel, Severity.Info);
        var tabId = "";
        if (open)
            tabId = await Js.InvokeAsync<string>("fileSave.beginOpen") ?? "";
        await InvokeAsync(StateHasChanged);
        try
        {
            var client = ClientFactory.CreateClient(Constants.API.ClientName);
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            using var response = await client.GetAsync(
                Constants.API.Expenses.Pdf(ReportId, ChargeQuery(target)), cts.Token);
            response.EnsureSuccessStatusCode();
            var bytes = await response.Content.ReadAsByteArrayAsync(cts.Token);
            var b64 = Convert.ToBase64String(bytes);
            var fileName = DownloadName(target);
            if (open)
            {
                var opened = await Js.InvokeAsync<bool>("fileSave.completeOpen", tabId, b64, "application/pdf");
                if (!opened)
                    await Js.InvokeVoidAsync("fileSave.download", b64, "application/pdf", fileName);
            }
            else
            {
                await Js.InvokeVoidAsync("fileSave.download", b64, "application/pdf", fileName);
            }
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrEmpty(tabId))
                await Js.InvokeVoidAsync("fileSave.cancelOpen", tabId);
            Snackbar.AddApiError(ex, open ? "Couldn't open the PDF." : "Couldn't download the PDF.");
        }
        finally
        {
            busy = false;
        }
    }
}
