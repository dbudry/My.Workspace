@using My.Shared.Rules

    <div class="tasks-toolbar stopwatch-list-toolbar">
        <div class="tasks-toolbar-row tasks-toolbar-view-row-project">
            <div class="tasks-search-control tasks-search-control-tabs-only">
                <SegmentedTabBar TValue="ListMode"
                                 Class="tasks-search-views"
                                 AriaLabel="Stopwatch view"
                                 Value="listMode"
                                 ValueChanged="SetListModeAsync"
                                 Tabs="ListModeTabs" />
            </div>
            @if (listMode == ListMode.Day)
            {
                <WeekNavControl WeekStartMonday="weekStartMonday"
                                WeekStartChanged="OnWeekNavChangedAsync"
                                Disabled="@isDayLoading" />
            }
        </div>
    </div>

    <PageLoader IsLoading="@(listMode == ListMode.Day ? isDayLoading : isLoading)">
        @if (listMode == ListMode.Day)
        {
            @if (daySections.Count == 0 || daySections.All(s => s.Rows.Count == 0))
            {
                <MudText Typo="Typo.h5" Align="Align.Center" Class="my-4" Style="color: var(--mud-palette-text-secondary);">
                    No stopwatch time this week.
                </MudText>
            }
            @foreach (var day in daySections)
            {
                <MudText Typo="Typo.subtitle1" Class="stopwatch-day-heading">@DayHeading(day.Day)</MudText>
                @if (day.Rows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                        No time yet today.
                    </MudText>
                }
                else
                {
                    <MudTable Items="@day.Rows" Hover="true" Dense="true"
                              Breakpoint="Breakpoint.Xs"
                              Class="mt-1 mb-4 tasks-list-table stopwatch-items-table"
                              RowClassFunc="@((row, _) => row.Item.IsRunning ? "running-row" : "")">
                        <ColGroup>
                            <col class="stopwatch-col-timer" />
                            <col class="tasks-col-project" />
                            <col class="tasks-col-name" />
                            <col class="stopwatch-col-total" />
                            <col class="tasks-col-actions" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>Timer</MudTh>
                            <MudTh>Project</MudTh>
                            <MudTh>Details</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh Style="text-align: center;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Timer">
                                @if (context.Item.IsRunning)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                               Disabled="@(busyItemId != null || context.Item.IsCleared)"
                                               OnClick="@(() => StopAsync(context.Item))">Stop</MudButton>
                                }
                                else if (CanStart(context.Item))
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               Disabled="@(busyItemId != null)"
                                               OnClick="@(() => StartAsync(context.Item))">Start</MudButton>
                                }
                            </MudTd>
                            <MudTd DataLabel="Project">
                                <ProjectAffiliationDisplay @key="@($"{context.ExpandKey}|{projectColorSource}")"
                                                           ProjectName="@context.Item.Project?.Name"
                                                           DisplayName="@GetProjectDisplayName(context.Item)"
                                                           OrganizationName="@context.Item.Project?.OrganizationName"
                                                           OrganizationColor="@context.Item.Project?.OrganizationColor"
                                                           ProjectGroupName="@context.Item.Project?.ProjectGroupName"
                                                           ProjectGroupColor="@context.Item.Project?.ProjectGroupColor"
                                                           ColorSource="@projectColorSource" />
                            </MudTd>
                            <MudTd DataLabel="Details" Class="tasks-details-cell">
                                <MudText Typo="Typo.body2" Class="tasks-details-ellipsis"
                                         Style="@(context.Item.IsRunning ? "font-weight: bold;" : "")">
                                    @context.Item.Details
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Total">
                                <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                    @FormatDayTotal(context)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align: center;">
                                <MudTooltip Text="Sessions">
                                    <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => OpenSessionsAsync(context.Item))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            <MudTr Class="stopwatch-expand-tab-row">
                                <MudTd colspan="5" Class="stopwatch-expand-tab-cell">
                                    <StopwatchRowExpandTab Expanded="@expandedKeys.Contains(context.ExpandKey)"
                                                           OnToggle="@(() => ToggleExpandAsync(context.ExpandKey))" />
                                </MudTd>
                            </MudTr>
                            @if (expandedKeys.Contains(context.ExpandKey))
                            {
                                <MudTr>
                                    <MudTd colspan="5" Class="stopwatch-session-expand-cell">
                                        <div class="stopwatch-session-expand-wrap">
                                            <StopwatchSessionExpandTable Sessions="@context.Sessions" />
                                        </div>
                                    </MudTd>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                }
            }
        }
        else if (items.Count <= 0)
        {
            <MudText Typo="Typo.h5" Align="Align.Center" Class="my-4" Style="color: var(--mud-palette-text-secondary);">
                No work items yet. Start one above.
            </MudText>
        }
        else
        {
            @* Mini pop-out: never card-stack (Breakpoint.None). Full page: Xs = cards only
               below 600px. MudBlazor 9's Sm stacks below 960px — do not use it here. *@
            <MudTable Items="@items" Hover="true" Dense="true"
                      Breakpoint="@(Compact ? Breakpoint.None : Breakpoint.Xs)"
                      Class="@($"mt-3 tasks-list-table stopwatch-items-table{(Compact ? " stopwatch-items-table-compact" : "")}")"
                      RowClassFunc="@((item, _) => item.IsRunning ? "running-row" : "")">
                <ColGroup>
                    <col class="stopwatch-col-timer" />
                    <col class="tasks-col-project" />
                    <col class="tasks-col-name" />
                    <col class="stopwatch-col-total" />
                    <col class="tasks-col-actions" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Timer</MudTh>
                    <MudTh>
                        <div class="tasks-project-header">
                            <span>Project</span>
                            <div class="tasks-project-color-toggle" role="tablist" aria-label="Project color source" @onclick:stopPropagation>
                                <button type="button"
                                        role="tab"
                                        class="@(projectColorSource == ProjectColorSource.Organization ? "is-active" : null)"
                                        aria-selected="@(projectColorSource == ProjectColorSource.Organization)"
                                        aria-label="By Organization"
                                        title="By Organization"
                                        disabled="@isSavingColorSource"
                                        @onclick="@(() => OnProjectColorSourceChangedAsync(ProjectColorSource.Organization))">Org</button>
                                <button type="button"
                                        role="tab"
                                        class="@(projectColorSource == ProjectColorSource.ProjectGroup ? "is-active" : null)"
                                        aria-selected="@(projectColorSource == ProjectColorSource.ProjectGroup)"
                                        aria-label="By Project Group"
                                        title="By Project Group"
                                        disabled="@isSavingColorSource"
                                        @onclick="@(() => OnProjectColorSourceChangedAsync(ProjectColorSource.ProjectGroup))">Group</button>
                            </div>
                        </div>
                    </MudTh>
                    <MudTh>Details</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh Style="text-align: center;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Timer">
                        @if (context.IsRunning)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                       Disabled="@(busyItemId != null)" OnClick="@(() => StopAsync(context))">Stop</MudButton>
                        }
                        else if (!string.IsNullOrEmpty(context.ProjectId))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Disabled="@(busyItemId != null)" OnClick="@(() => StartAsync(context))">Start</MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="Assign a project before starting">
                                <span>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                               Disabled="true">Start</MudButton>
                                </span>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Project">
                        @if (string.IsNullOrEmpty(context.ProjectId) && context.Project == null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="px-1"
                                       OnClick="@(() => OpenEditItemAsync(context))">Assign project</MudButton>
                        }
                        else
                        {
                            <ProjectAffiliationDisplay @key="@($"{context.StopwatchItemId}|{projectColorSource}")"
                                                       ProjectName="@context.Project?.Name"
                                                       DisplayName="@GetProjectDisplayName(context)"
                                                       OrganizationName="@context.Project?.OrganizationName"
                                                       OrganizationColor="@context.Project?.OrganizationColor"
                                                       ProjectGroupName="@context.Project?.ProjectGroupName"
                                                       ProjectGroupColor="@context.Project?.ProjectGroupColor"
                                                       ColorSource="@projectColorSource" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Details" Class="tasks-details-cell">
                        <MudTooltip>
                            <ChildContent>
                                <MudText Typo="Typo.body2" Class="tasks-details-ellipsis"
                                         Style="@(context.IsRunning ? "font-weight: bold;" : "")">
                                    @context.Details
                                </MudText>
                            </ChildContent>
                            <TooltipContent>
                                <div class="tasks-details-tooltip">@context.Details</div>
                            </TooltipContent>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Total">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">
                            @FormatTotal(context)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: center;">
                        <div class="d-flex justify-center" style="gap: 2px;">
                            @* Deleting a work item (and all its sessions) lives inside the sessions dialog now —
                               everything else (name/project when unlocked, session durations) already did. *@
                            <MudTooltip Text="Sessions — durations, create duration, timer; edit name/project when unlocked">
                                <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => OpenSessionsAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="@(context.IsRunning
                                ? "Stop the timer before removing this from your list"
                                : "Remove from your list — keeps all logged time")">
                                <span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                                   Disabled="@(busyItemId != null || context.IsRunning)"
                                                   OnClick="@(() => ClearItemAsync(context))" />
                                </span>
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    <MudTr Class="stopwatch-expand-tab-row">
                        <MudTd colspan="5" Class="stopwatch-expand-tab-cell">
                            <StopwatchRowExpandTab Expanded="@expandedKeys.Contains(context.StopwatchItemId)"
                                                   OnToggle="@(() => ToggleExpandAsync(context.StopwatchItemId, context))" />
                        </MudTd>
                    </MudTr>
                    @if (expandedKeys.Contains(context.StopwatchItemId))
                    {
                        <MudTr>
                            <MudTd colspan="5" Class="stopwatch-session-expand-cell">
                                @if (loadingExpandKeys.Contains(context.StopwatchItemId))
                                {
                                    <MudProgressLinear Indeterminate="true" Class="my-2" />
                                }
                                else
                                {
                                    <div class="stopwatch-session-expand-wrap">
                                        <StopwatchSessionExpandTable Sessions="@ItemExpandSessions(context.StopwatchItemId)"
                                                                     ShowDate="true" />
                                    </div>
                                }
                            </MudTd>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>

            <MudPagination Class="mt-4 d-flex justify-center" Count="@pagingAttributes.TotalPageCount"
                           Selected="@(currentPage + 1)" SelectedChanged="@((int p) => PageChanged(p - 1))" />
        }
    </PageLoader>
