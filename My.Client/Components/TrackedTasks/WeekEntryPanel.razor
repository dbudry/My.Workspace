@namespace My.Client.Components.TrackedTasks
@using My.Shared.Rules

@* Project view body only. Toolbar (week + business/full + project + New Task)
   lives on Tasks.razor so every control shares one left-aligned row. *@

@if (isLoading)
{
    <div class="d-flex align-center gap-2 mb-2 tasks-project-status">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        <MudText Typo="Typo.caption">Loading week…</MudText>
    </div>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@loadError</MudAlert>
}
else if (!HasProject)
{
    <EmptyState Class="tasks-project-empty"
                Icon="@Icons.Material.Outlined.WorkOutline"
                Title="Choose a project"
                Message="Select a project. Existing tasks load as rows; use New Task to add another." />
}
else if (taskRows.Count == 0)
{
    <EmptyState Class="tasks-project-empty"
                Icon="@Icons.Material.Outlined.Assignment"
                Title="No tasks this week"
                Message="Click New Task to add a task row, then enter duration for each day." />
}
else if (!VisibleTaskRows.Any())
{
    <EmptyState Class="tasks-project-empty"
                Icon="@Icons.Material.Outlined.SearchOff"
                Title="No matching entries"
                Message="Nothing on this project this week matches your search." />
}
else
{
    <div class="week-entry-grid-wrap mb-3">
    <div class="week-entry-grid-scroll">
        <table class="week-entry-grid-table">
            <thead>
                <tr>
                    <th class="week-entry-col-task">
                        Details
                    </th>
                    @foreach (var day in visibleDays)
                    {
                        <th class="week-entry-col-day">
                            @DayHeader(day)
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in VisibleTaskRows)
                {
                    <tr>
                        <td class="week-entry-col-task">
                            @if (row.HasPersistedData)
                            {
                                @* Label only — no dialog (a row spans multiple days; day is ambiguous). *@
                                <MudText Typo="Typo.body2" Class="week-entry-task-label">
                                    @row.SelectedTaskName
                                </MudText>
                            }
                            else
                            {
                                @* Placeholder only (no floating label) so the field lines up with day duration inputs. *@
                                <div class="d-flex align-center gap-1">
                                    <MudTextField T="string"
                                                  Value="@row.DraftTaskName"
                                                  ValueChanged="@(v => OnDraftTaskNameChanged(row, v))"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Immediate="true"
                                                  Placeholder="Details"
                                                  Class="week-entry-draft-task-name"
                                                  Style="min-width: 11rem; max-width: 16rem;" />
                                    <MudTooltip Text="Remove unused row">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       aria-label="Remove unused row"
                                                       OnClick="@(() => RemoveDraftRow(row))" />
                                    </MudTooltip>
                                </div>
                            }
                        </td>
                        @for (var di = 0; di < row.Cells.Length; di++)
                        {
                            var dayIndex = di;
                            var cell = row.Cells[dayIndex];
                            <td class="week-entry-col-day">
                                <MudTooltip Text="@(cell.HintTooltip ?? "")"
                                            Disabled="@(string.IsNullOrEmpty(cell.HintTooltip))"
                                            Placement="Placement.Top">
                                <div class="week-entry-day-cell">
                                    @* Pencil is always inside the field (Adornment.End) so every cell has the same width. *@
                                    <MudTextField T="string"
                                                  Value="@(cell.IsReadOnly
                                                      ? (cell.SavedDuration > TimeSpan.Zero
                                                          ? WeekEntryGridRules.FormatDayDurationInput(cell.SavedDuration)
                                                          : "")
                                                      : cell.DurationText)"
                                                  ValueChanged="@(v => { if (!cell.IsReadOnly) OnDurationChanged(row, dayIndex, v); })"
                                                  OnBlur="@(() => OnDurationBlur(row, dayIndex))"
                                                  OnKeyDown="@(e => OnDurationKeyDown(row, dayIndex, e))"
                                                  Margin="Margin.Dense"
                                                  Variant="Variant.Outlined"
                                                  Immediate="true"
                                                  Placeholder="00:00"
                                                  MaxLength="7"
                                                  ReadOnly="@cell.IsReadOnly"
                                                  Disabled="@isLoading"
                                                  Class="week-entry-day-duration"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.Edit"
                                                  IconSize="Size.Small"
                                                  AdornmentColor="@(string.IsNullOrEmpty(cell.TaskId) ? Color.Default : Color.Primary)"
                                                  OnAdornmentClick="@(() => OpenTaskDialogForCellAsync(row, cell))" />
                                    @if (ShowSubmittedLock(cell))
                                    {
                                        <MudTooltip Text="Submitted month — locked">
                                            <MudIcon Icon="@Icons.Material.Outlined.Lock"
                                                     Size="Size.Small"
                                                     Class="week-entry-day-status"
                                                     Style="font-size: 0.9rem; color: var(--mud-palette-text-secondary);" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                    <MudText Typo="Typo.caption"
                                             Align="Align.Center"
                                             Class="week-entry-day-status"
                                             Style="@(cell.Status == CellSaveStatus.Error
                                                 || (!string.IsNullOrEmpty(cell.ErrorMessage) && !cell.IsMultiple)
                                                 ? "color: var(--mud-palette-error);"
                                                 : "color: var(--mud-palette-text-secondary);")">
                                        @(!string.IsNullOrEmpty(cell.ErrorMessage) && cell.IsReadOnly
                                            ? cell.ErrorMessage
                                            : StatusLabel(cell))
                                    </MudText>
                                    }
                                </div>
                                </MudTooltip>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
        <table class="week-entry-grid-table week-entry-totals-table">
            <tfoot>
                <tr>
                    <td class="week-entry-col-task">
                        <MudText Typo="Typo.subtitle2">Total</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                            This project
                        </MudText>
                    </td>
                    @for (var di = 0; di < visibleDays.Count; di++)
                    {
                        <td class="week-entry-col-day" style="font-family: monospace;">
                            <strong>@DayColumnTotalLabel(di)</strong>
                        </td>
                    }
                </tr>
                <tr>
                    <td class="week-entry-col-task">
                        <MudText Typo="Typo.subtitle2">All projects</MudText>
                    </td>
                    @for (var di = 0; di < visibleDays.Count; di++)
                    {
                        <td class="week-entry-col-day" style="font-family: monospace; color: var(--mud-palette-text-secondary);">
                            <strong>@AllProjectsDayTotalLabel(di)</strong>
                        </td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
}
