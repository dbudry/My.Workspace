@using My.Client.Services
@using My.Shared.Constants

<MudDialog>
    <DialogContent>
        <DialogFormStack>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                Pick the role-set you want to view the app as. Authorization on both
                the client and the API is downgraded to exactly these roles. An empty
                selection tests what an unauthorized user sees.
            </MudText>

            <MudTextField @bind-Value="filter" Placeholder="Filter roles…"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            <div class="impersonate-role-list">
            @{
                var visibleRoles = FilteredRoles.ToList();
            }
            @if (visibleRoles.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-3" Style="color: var(--mud-palette-text-secondary);">
                    No roles match "@filter".
                </MudText>
            }
            else
            {
                @foreach (var group in Grouped(visibleRoles))
                {
                    <div class="impersonate-scope">@group.Scope</div>
                    @foreach (var role in group.Roles)
                    {
                        <div class="impersonate-role-row">
                            <MudCheckBox T="bool" Value="@selected.Contains(role)"
                                         ValueChanged="@((bool v) => Toggle(role, v))"
                                         Label="@RoleLabel(role)" Color="Color.Primary" Dense="true" />
                        </div>
                    }
                }
            }
        </div>

            @if (selected.Count > 0)
            {
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                    Selected: @string.Join(", ", selected.OrderBy(RoleSortKey, StringComparer.Ordinal).Select(Constants.Roles.FormatRole))
                </MudText>
            }
        </DialogFormStack>
    </DialogContent>
    <DialogActions>
        @if (Impersonation.IsActive)
        {
            <MudButton Color="Color.Error" OnClick="StopImpersonating">Stop impersonating</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Apply">Apply</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .impersonate-role-list {
        max-height: 280px;
        overflow-y: auto;
        border: 1px solid var(--mud-palette-divider);
        border-radius: 4px;
        padding: 4px 0;
    }

    .impersonate-scope {
        padding: 8px 12px 2px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--mud-palette-text-secondary);
    }

    .impersonate-role-row {
        padding: 2px 12px;
    }

    .impersonate-role-row:hover {
        background-color: var(--mud-palette-action-default-hover);
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private ImpersonationService Impersonation { get; set; } = null!;

    private static readonly IReadOnlyList<string> AvailableRoles = Constants.Roles.Assignable();

    private HashSet<string> selected = new(StringComparer.Ordinal);
    private string filter = string.Empty;

    protected override void OnInitialized()
    {
        selected = new HashSet<string>(Impersonation.Roles, StringComparer.Ordinal);
    }

    private static readonly string[] ScopeOrder =
    [
        "Global",
        Constants.Scopes.Tyme,
        Constants.Scopes.Intranet,
        Constants.Scopes.Organizations,
        Constants.Scopes.Expenses,
        Constants.Scopes.Crm
    ];

    private static readonly string[] RoleRank =
    [
        Constants.Roles.User,
        Constants.Roles.Editor,
        Constants.Roles.Manager,
        Constants.Roles.Analyst,
        Constants.Roles.Navigation,
        Constants.Roles.UserAccess,
        Constants.Roles.Admin
    ];

    private IEnumerable<string> FilteredRoles =>
        string.IsNullOrWhiteSpace(filter)
            ? AvailableRoles
            : AvailableRoles.Where(r =>
                r.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || ScopeLabel(r).Contains(filter, StringComparison.OrdinalIgnoreCase)
                || RoleLabel(r).Contains(filter, StringComparison.OrdinalIgnoreCase));

    private static IEnumerable<(string Scope, IReadOnlyList<string> Roles)> Grouped(IEnumerable<string> roles) =>
        roles
            .GroupBy(ScopeLabel)
            .OrderBy(group => ScopeIndex(group.Key))
            .Select(group => (group.Key, (IReadOnlyList<string>)group.OrderBy(RoleSortKey, StringComparer.Ordinal).ToList()));

    private static int ScopeIndex(string scope)
    {
        var index = Array.IndexOf(ScopeOrder, scope);
        return index < 0 ? ScopeOrder.Length : index;
    }

    private static string RoleSortKey(string role)
    {
        var index = Array.IndexOf(RoleRank, RoleName(role));
        if (index < 0)
            index = RoleRank.Length;
        return $"{index:D2}{role}";
    }

    private static string ScopeLabel(string role)
    {
        var split = role.IndexOf(':');
        return split < 0 ? "Global" : role[(split + 1)..];
    }

    private static string RoleName(string role)
    {
        var split = role.IndexOf(':');
        return split < 0 ? role : role[..split];
    }

    private static string RoleLabel(string role) =>
        RoleName(role) == Constants.Roles.UserAccess ? "User Access" : RoleName(role);

    private void Toggle(string role, bool isSelected)
    {
        if (isSelected) selected.Add(role);
        else selected.Remove(role);
    }

    private async Task Apply()
    {
        await Impersonation.SetAsync(selected);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task StopImpersonating()
    {
        await Impersonation.ClearAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
