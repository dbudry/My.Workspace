<div class="settings-row-actions @(Orderable ? "has-order" : null)">
    @if (Orderable)
    {
        <MudTooltip Text="Move up">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                           aria-label="Move up" Disabled="@(Disabled || !CanMoveUp)"
                           OnClick="@(() => OnMoveUp.InvokeAsync())" />
        </MudTooltip>
        <MudTooltip Text="Move down">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                           aria-label="Move down" Disabled="@(Disabled || !CanMoveDown)"
                           OnClick="@(() => OnMoveDown.InvokeAsync())" />
        </MudTooltip>
    }
    @if (ShowSave)
    {
        <MudTooltip Text="Save">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small"
                           aria-label="Save" Disabled="@Disabled"
                           OnClick="@(() => OnSave.InvokeAsync())" />
        </MudTooltip>
    }
    else
    {
        <span class="settings-row-spacer"></span>
    }
    @if (ShowRemove)
    {
        <MudTooltip Text="Remove">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           aria-label="Remove" Disabled="@Disabled"
                           OnClick="@(() => OnRemove.InvokeAsync())" />
        </MudTooltip>
    }
    else
    {
        <span class="settings-row-spacer"></span>
    }
</div>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowSave { get; set; } = true;
    [Parameter] public bool ShowRemove { get; set; } = true;
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public bool Orderable { get; set; }
    [Parameter] public bool CanMoveUp { get; set; } = true;
    [Parameter] public bool CanMoveDown { get; set; } = true;
    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }
}
