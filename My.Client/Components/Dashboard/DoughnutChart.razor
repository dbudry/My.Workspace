@using My.Client.Models.Dashboard
@using My.Shared.Rules

@if (Data.Any())
{
    <div class="d-flex flex-column align-center" style="width:100%;">
        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@Series" ChartLabels="@Labels"
                  ChartOptions="@Options" Width="300px" Height="300px" />
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
            Total: @TotalText
        </MudText>
    </div>
}
else
{
    <MudText Typo="Typo.body1" Color="Color.Default">No data available</MudText>
}

@code {
    private List<ChartSeries<double>> Series => new()
    {
        new ChartSeries<double> { Name = "Project Time", Data = Data.Select(p => p.TimeInt).ToArray() }
    };

    private double TotalSeconds => Data.Sum(p => p.TimeInt);

    // Percent mode: "<name> (NN%)" — a donut with no numbers is mostly decorative.
    // Duration mode: "<name> (Hh Mm)" so the legend reads real time instead of a share.
    // Falls back to bare names when the total rounds to zero so we don't print "NaN%".
    private string[] Labels
    {
        get
        {
            var total = TotalSeconds;
            if (total <= 0)
                return Data.Select(p => p.ProjectName).ToArray();

            return ValueMode == ChartValueMode.Duration
                ? Data.Select(p => $"{p.ProjectName} ({WeekEntryGridRules.FormatDuration(TimeSpan.FromSeconds(p.TimeInt))})").ToArray()
                : Data.Select(p => $"{p.ProjectName} ({p.TimeInt / total:P0})").ToArray();
        }
    }

    private string TotalText => ValueMode == ChartValueMode.Duration
        ? WeekEntryGridRules.FormatDuration(TimeSpan.FromSeconds(TotalSeconds))
        : "100%";

    private ChartOptions Options => Palette is { Length: > 0 }
        ? new ChartOptions { ChartPalette = Palette }
        : new ChartOptions();
}
