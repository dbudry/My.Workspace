@attribute [Authorize]
@using My.Client.Models.Dashboard
@using My.Shared
@using My.Shared.Rules

@* The "Dashboard" page title comes from the app bar (set by Index.razor); on mobile
   the app bar collapses and the page title still appears via PageHeader-equivalent
   surfaces. We don't render an inline h5 here because it would duplicate. *@

@if (profileLoadFailed)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.CloudOff">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
            <div>
                <div>
                    Signed in with Google, but your app profile didn't load.
                    Dashboard data stays empty until your profile is loaded.
                </div>
                @if (!string.IsNullOrWhiteSpace(profileLoadDetail))
                {
                    <MudText Typo="Typo.caption" Class="mt-1" Style="color: var(--mud-palette-warning-darken);">
                        @profileLoadDetail
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-1" Style="color: var(--mud-palette-text-secondary);">
                        Often a cold start, or the account was never created in Users. Ask an admin to check App Insights for "Provision denied".
                    </MudText>
                }
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@isRetryingProfile"
                       OnClick="RetryProfileLoadAsync">
                @(isRetryingProfile ? "Retrying…" : "Retry")
            </MudButton>
        </div>
    </MudAlert>
}


@if (overdueMonths.Count > 0 || overdueExpenseReports.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 dashboard-alerts" NoIcon="true">
        <MudStack Spacing="2">
            @if (overdueMonths.Count > 0)
            {
                <div class="dashboard-alert-row">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="dashboard-alert-row__icon" />
                    <span class="dashboard-alert-row__text">
                        You have <b>@overdueMonths.Count</b>
                        unsubmitted Tyme month@(overdueMonths.Count == 1 ? string.Empty : "s"):
                        @string.Join(", ", overdueMonths.Select(m => new DateTime(m.Year, m.Month, 1).ToString("MMM yyyy")))
                    </span>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="@(() => Navigation.NavigateTo("tyme/submit"))">
                        Submit Tasks
                    </MudButton>
                </div>
            }
            @if (overdueExpenseReports.Count > 0)
            {
                <div class="dashboard-alert-row">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="dashboard-alert-row__icon" />
                    <span class="dashboard-alert-row__text">
                        You have <b>@overdueExpenseReports.Count</b>
                        unsubmitted expense month@(overdueExpenseReports.Count == 1 ? string.Empty : "s"):
                        @string.Join(", ", overdueExpenseReports.Select(r => new DateTime(r.Year, r.Month, 1).ToString("MMM yyyy")))
                    </span>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="OpenOverdueExpenses">
                        Submit expenses
                    </MudButton>
                </div>
            }
        </MudStack>
    </MudAlert>
}

<PageLoader IsLoading="@isLoading">
    @if (profileLoadFailed)
    {
        @* Alert rendered above; keep shell empty until profile loads. *@
    }
    else if (loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <span>@loadError</span>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">Retry</MudButton>
            </div>
        </MudAlert>
    }
    else
    {
        <div @ref="layoutGrid" class="dashboard-layout dashboard-board">
            @foreach (var widget in visibleLayout)
            {
                var widgetId = widget.Id;
                var spec = DashboardLayoutRules.Spec(widgetId);
                var tileClass = "dashboard-tile" + (isArranging ? " dashboard-tile--arranging" : "");
                <div @key="widgetId"
                     data-dashboard-tile="@widgetId"
                     data-col="@widget.Col"
                     data-row="@widget.Row"
                     data-columns="@widget.Columns"
                     data-rows="@widget.Rows"
                     data-min-columns="@spec.MinColumns"
                     data-min-rows="@spec.MinRows"
                     data-max-columns="@spec.MaxColumns"
                     data-max-rows="@spec.MaxRows"
                     data-compact-min-columns="@spec.CompactMinColumns"
                     data-compact-min-rows="@spec.CompactMinRows"
                     class="@tileClass"
                     style="@TileStyle(widget)">
                        @if (isArranging)
                        {
                            <button type="button" class="dashboard-tile__drag" title="Drag to move"
                                    data-dash-handle="move">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                            </button>
                            <div class="dashboard-tile__resize-w" title="Drag to widen"
                                 data-dash-handle="west">
                            </div>
                            <div class="dashboard-tile__resize-e" title="Drag to widen"
                                 data-dash-handle="east">
                            </div>
                            <div class="dashboard-tile__resize-s" title="Drag to lengthen"
                                 data-dash-handle="south">
                            </div>
                            <div class="dashboard-tile__min-ghost" data-dash-min-ghost></div>
                            <div class="dashboard-tile__metrics" data-dash-metrics>
                                <strong data-dash-metrics-live>@widget.Columns × @widget.Rows</strong>
                                <span data-dash-metrics-cols>cols @spec.EffectiveMinColumns(widget.Rows)–@spec.MaxColumns</span>
                                <span data-dash-metrics-rows>rows @spec.EffectiveMinRows(widget.Columns)–@spec.MaxRows</span>
                            </div>
                        }
                    <div class="dashboard-tile__body">
                    @switch (widgetId)
                    {
                        case DashboardLayoutRules.ProjectMix:
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Project mix (last 12 months)</MudText>
                                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                                            Grouped by @AxisLabel.
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <div class="d-flex flex-column align-end gap-1">
                                            <MudToggleGroup T="ChartAxis" @bind-Value="selectedAxis" Color="Color.Primary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartAxis.Organization">Org</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.Project">Project</MudToggleItem>
                                                <MudToggleItem Value="ChartAxis.ProjectGroup">Group</MudToggleItem>
                                            </MudToggleGroup>
                                            <MudToggleGroup T="ChartValueMode" @bind-Value="selectedValueMode" Color="Color.Secondary"
                                                            SelectionMode="SelectionMode.SingleSelection" Size="Size.Small">
                                                <MudToggleItem Value="ChartValueMode.Percent">Percent</MudToggleItem>
                                                <MudToggleItem Value="ChartValueMode.Duration">Duration</MudToggleItem>
                                            </MudToggleGroup>
                                        </div>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent Class="d-flex justify-center align-center flex-grow-1" Style="min-height:0;">
                                    <DoughnutChart Data="@pivotedChartData" Palette="@PivotPalette" ValueMode="@selectedValueMode"
                                                   ChartWidth="240px" ChartHeight="200px" />
                                </MudCardContent>
                            </MudCard>
                            break;
                        case DashboardLayoutRules.TopProjects:
                            <div class="dashboard-top-projects @(widget.Rows <= 1 || widget.Columns >= 6 ? "dashboard-top-projects--row" : "dashboard-top-projects--stack")">
                                <MudCard Class="flex-grow-1">
                                    <MudCardHeader>
                                        <MudText Typo="Typo.h6">Top project last month</MudText>
                                    </MudCardHeader>
                                    <MudCardContent Class="dashboard-top-projects__value">
                                        <MudText Typo="Typo.h5">@TopProjectLastMonth</MudText>
                                    </MudCardContent>
                                </MudCard>
                                <MudCard Class="flex-grow-1">
                                    <MudCardHeader>
                                        <MudText Typo="Typo.h6">Top project this month</MudText>
                                    </MudCardHeader>
                                    <MudCardContent Class="dashboard-top-projects__value">
                                        <MudText Typo="Typo.h5">@TopProjectThisMonth</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </div>
                            break;
                        case DashboardLayoutRules.Favorites:
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Favorite pages</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (intranetFavoriteLinks.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
                                            No favorite pages yet. Add one below, or star a page in Intranet.
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudStack Spacing="1" Class="mb-2">
                                            @foreach (var favorite in intranetFavoriteLinks)
                                            {
                                                <div class="d-flex align-center gap-1">
                                                    <MudLink Href="@IntranetPageUrlHelper.GetViewPath(favorite.PageId, favorite.Slug)" Typo="Typo.body2" Class="flex-grow-1">
                                                        @favorite.Title
                                                    </MudLink>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                                   aria-label="@($"Remove {favorite.Title} from favorites")"
                                                                   Disabled="@isUpdatingFavorite"
                                                                   OnClick="@(() => RemoveFavoriteAsync(favorite.PageId))" />
                                                </div>
                                            }
                                        </MudStack>
                                    }
                                    @if (pagesNotFavorited.Any())
                                    {
                                        <MudSelect T="string" Value="favoritePageToAdd"
                                                   ValueChanged="AddFavoriteAsync"
                                                   Label="Add page" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Disabled="@isUpdatingFavorite" Clearable="true">
                                            @foreach (var page in pagesNotFavorited)
                                            {
                                                <MudSelectItem T="string" Value="@(page.PageId)">@(string.IsNullOrWhiteSpace(page.Title) ? "Untitled page" : page.Title)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                </MudCardContent>
                            </MudCard>
                            break;
                        case DashboardLayoutRules.UnsubmittedTime:
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Employees with unsubmitted time</MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                   OnClick="@(() => Navigation.NavigateTo("tyme/submit?view=team"))">
                                            Open Team
                                        </MudButton>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    <My.Client.Components.TimeSubmissions.TeamSubmissionsView
                                        ShowFilters="false"
                                        ShowActions="false"
                                        DefaultStatusFilter="unsubmitted"
                                        MaxRows="10"
                                        EmptyMessage="Nothing outstanding. Everyone is up to date." />
                                </MudCardContent>
                            </MudCard>
                            break;
                        case DashboardLayoutRules.LastMonthExpenses:
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Last month's expenses — @lastMonthExpenseLabel</MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                   OnClick="@(() => Navigation.NavigateTo("expenses?view=team"))">
                                            Open Team
                                        </MudButton>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (lastMonthTeamExpenses.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                                            No expense reports for @lastMonthExpenseLabel yet.
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudTable Items="@visibleLastMonthExpenses" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                            <HeaderContent>
                                                <MudTh>Employee</MudTh>
                                                <MudTh>Status</MudTh>
                                                <MudTh Style="text-align:right;">Total</MudTh>
                                                <MudTh Style="width:88px; text-align:right;">Actions</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Employee">@context.EmployeeName</MudTd>
                                                <MudTd DataLabel="Status">
                                                    <ExpenseStatusChip Status="@context.Status" />
                                                </MudTd>
                                                <MudTd DataLabel="Total" Style="text-align:right;">@context.TotalAmount.ToString("C")</MudTd>
                                                <MudTd DataLabel="Actions" Style="text-align:right;">
                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.OpenInNew"
                                                               OnClick="@(() => Navigation.NavigateTo($"expenses/{context.ExpenseReportId}"))">
                                                        Open
                                                    </MudButton>
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                        @if (lastMonthTeamExpenses.Count > LastMonthExpenseMaxRows)
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-2" Style="color: var(--mud-palette-text-secondary);">
                                                Showing @visibleLastMonthExpenses.Count of @lastMonthTeamExpenses.Count. Open Team for the rest.
                                            </MudText>
                                        }
                                    }
                                </MudCardContent>
                            </MudCard>
                            break;
                    }
                    </div>
                </div>
            }
        </div>
    }
</PageLoader>

@code {
    private RenderFragment ArrangeToolbar => __builder =>
    {
        @if (isArranging)
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                       OnClick="ResetLayoutAsync">
                Reset
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="ToggleArrangeAsync">
                Done
            </MudButton>
        }
        else
        {
            <MudTooltip Text="Arrange dashboard">
                <MudIconButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                               Icon="@Icons.Material.Filled.DashboardCustomize"
                               aria-label="Arrange"
                               OnClick="ToggleArrangeAsync" />
            </MudTooltip>
        }
    };
}
